# Tagalong Environment Variables
# Copy this file to .env and replace the values with your actual secrets.

# Database Connection String
DB_CONNECTION_STRING=Server=localhost;Database=TagalongDb;User Id=sa;Password=<YOUR_STRONG_PASSWORD>;TrustServerCertificate=True;

# Optional: PostgreSQL Connection String (Render / Production)
# ConnectionStrings__DefaultConnection=postgresql://<username>:<password>@<host>/<database>?sslmode=require
