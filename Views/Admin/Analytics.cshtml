@model Tagalong.Models.ViewModels.AdminAnalyticsViewModel
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-muted">Admin</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Analytics</li>
            </ol>
        </nav>
        <header>
            <h1 id="page-title" class="display-5 fw-bold mb-1">Analytics Dashboard</h1>
            <p class="lead text-muted mb-0">Platform performance and user insights</p>
        </header>
    </div>
</section>

<section class="dashboard-page">
    <div class="container-fluid px-md-4 px-lg-5">
        <!-- Key Metrics Grid -->
        <div class="metrics-grid mb-5" role="region" aria-label="Key metrics">
            <article class="metric-card">
                <div class="metric-icon bg-primary">
                    <i data-lucide="car" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Total Rides</p>
                    <p class="metric-value" data-count="@Model.TotalRides">@Model.TotalRides</p>
                    <span class="metric-trend positive">
                        <i data-lucide="trending-up" aria-hidden="true"></i>
                        <span>+12%</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-success">
                    <i data-lucide="check-circle" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Completed Rides</p>
                    <p class="metric-value" data-count="@Model.CompletedRides">@Model.CompletedRides</p>
                    <span class="metric-trend positive">
                        <i data-lucide="trending-up" aria-hidden="true"></i>
                        <span>+8%</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-danger">
                    <i data-lucide="x-circle" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Cancelled Rides</p>
                    <p class="metric-value" data-count="@Model.CancelledRides">@Model.CancelledRides</p>
                    <span class="metric-trend negative">
                        <i data-lucide="trending-down" aria-hidden="true"></i>
                        <span>-3%</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-info">
                    <i data-lucide="activity" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Active Rides</p>
                    <p class="metric-value" data-count="@Model.ActiveRides">@Model.ActiveRides</p>
                    <span class="metric-trend neutral">
                        <i data-lucide="minus" aria-hidden="true"></i>
                        <span>--</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-secondary">
                    <i data-lucide="users" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Total Users</p>
                    <p class="metric-value" data-count="@Model.TotalUsers">@Model.TotalUsers</p>
                    <span class="metric-trend positive">
                        <i data-lucide="trending-up" aria-hidden="true"></i>
                        <span>+15%</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-warning">
                    <i data-lucide="truck" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Total Drivers</p>
                    <p class="metric-value" data-count="@Model.TotalDrivers">@Model.TotalDrivers</p>
                    <span class="metric-trend positive">
                        <i data-lucide="trending-up" aria-hidden="true"></i>
                        <span>+22%</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-success-alt">
                    <i data-lucide="user" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Total Riders</p>
                    <p class="metric-value" data-count="@Model.TotalRiders">@Model.TotalRiders</p>
                    <span class="metric-trend positive">
                        <i data-lucide="trending-up" aria-hidden="true"></i>
                        <span>+10%</span>
                    </span>
                </div>
            </article>
            <article class="metric-card">
                <div class="metric-icon bg-dark">
                    <i data-lucide="alert-triangle" aria-hidden="true"></i>
                </div>
                <div class="metric-content">
                    <p class="metric-label">Open Complaints</p>
                    <p class="metric-value" data-count="@Model.OpenComplaints">@Model.OpenComplaints</p>
                    <span class="metric-trend @(Model.OpenComplaints > 10 ? "negative" : "positive")">
                        <i data-lucide="@(Model.OpenComplaints > 10 ? "trending-up" : "trending-down")" aria-hidden="true"></i>
                        <span>@(Model.OpenComplaints > 10 ? "Needs attention" : "Under control")</span>
                    </span>
                </div>
            </article>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-5">
            <!-- Complaint Resolution Chart -->
            <div class="col-12 col-xl-6">
                <div class="chart-card">
                    <div class="chart-header">
                        <h3 class="h5 fw-bold mb-0">Complaint Resolution</h3>
                        <div class="chart-legend">
                            <span class="legend-item">
                                <span class="legend-color" style="background: var(--color-brand-primary);"></span>
                                Open
                            </span>
                            <span class="legend-item">
                                <span class="legend-color" style="background: var(--color-success);"></span>
                                Resolved
                            </span>
                        </div>
                    </div>
                    <div class="chart-wrapper" style="height: 300px;">
                        <canvas id="complaintChart" aria-label="Complaint resolution doughnut chart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Rides Over Time Chart -->
            <div class="col-12 col-xl-6">
                <div class="chart-card">
                    <div class="chart-header">
                        <h3 class="h5 fw-bold mb-0">Rides Trend (Last 30 Days)</h3>
                    </div>
                    <div class="chart-wrapper" style="height: 300px;">
                        <canvas id="ridesTrendChart" aria-label="Rides trend line chart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Routes Table -->
        <div class="row g-4 mb-5">
            <div class="col-12">
                <div class="data-card">
                    <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                        <h3 class="h5 fw-bold mb-0">Top Routes (Completed Rides)</h3>
                        <div class="card-actions">
                            <button class="btn btn-outline-secondary btn-sm" id="exportRoutes">
                                <i data-lucide="download" class="me-1" aria-hidden="true"></i>
                                Export
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.TopRoutes != null && Model.TopRoutes.Any())
                        {
                            <div class="table-responsive">
                                <table class="data-table" role="grid">
                                    <thead>
                                        <tr>
                                            <th scope="col">Rank</th>
                                            <th scope="col">Route</th>
                                            <th scope="col">Rides</th>
                                            <th scope="col">Completion Rate</th>
                                            <th scope="col">Avg. Rating</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rank = 1;
                                            foreach (var route in Model.TopRoutes)
                                            {
                                                var completionRate = route.TotalAttempts > 0 ? (int)Math.Round((double)route.Count / route.TotalAttempts * 100) : 0;
                                                <tr>
                                                    <td><span class="rank-badge">#@rank</span></td>
                                                    <td>
                                                        <div class="route-info">
                                                            <span class="route-start">@route.StartLocation</span>
                                                            <i data-lucide="arrow-right" class="route-arrow" aria-hidden="true"></i>
                                                            <span class="route-end">@route.EndLocation</span>
                                                        </div>
                                                    </td>
                                                    <td class="fw-medium">@route.Count</td>
                                                    <td>
                                                        <div class="progress-mini">
                                                            <div class="progress-bar" style="width: @completionRate%; background: @(completionRate >= 80 ? "var(--color-success)" : completionRate >= 60 ? "var(--color-warning)" : "var(--color-danger)");"></div>
                                                        </div>
                                                        <span class="text-sm text-muted">@completionRate%</span>
                                                    </td>
                                                    <td>
                                                        <div class="rating-display">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i data-lucide="star" class="@(i <= Math.Round(route.AvgRating) ? "fill text-warning" : "text-muted")" aria-hidden="true"></i>
                                                            }
                                                            <span class="ms-1 text-sm">@route.AvgRating.ToString("0.0")</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                rank++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state text-center py-5">
                                <i data-lucide="map" class="mx-auto text-muted mb-3" style="width: 64px; height: 64px;" aria-hidden="true"></i>
                                <h4 class="h5 fw-bold mb-2">No route data available</h4>
                                <p class="text-muted mb-0">Complete rides will appear here</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Drivers Section -->
        <div class="row g-4 mb-5">
            <!-- Top Drivers by Rating -->
            <div class="col-12 col-xl-4">
                <div class="data-card">
                    <div class="card-header">
                        <h3 class="h5 fw-bold mb-0">Top Drivers by Rating</h3>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.TopDriversByRating != null && Model.TopDriversByRating.Any())
                        {
                            <div class="table-responsive">
                                <table class="data-table" role="grid">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Driver</th>
                                            <th scope="col">Rating</th>
                                            <th scope="col">Rides</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rank = 1;
                                            foreach (var driver in Model.TopDriversByRating)
                                            {
                                                <tr>
                                                    <td><span class="rank-badge">#@rank</span></td>
                                                    <td>
                                                        <div class="driver-info">
                                                            <span class="driver-name">@driver.FullName</span>
                                                            <small class="text-muted d-block">@driver.VehicleInfo</small>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="rating-display">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i data-lucide="star" class="@(i <= Math.Round(driver.AverageRating) ? "fill text-warning" : "text-muted")" aria-hidden="true"></i>
                                                            }
                                                            <span class="ms-1 text-sm fw-medium">@driver.AverageRating.ToString("0.0")</span>
                                                        </div>
                                                    </td>
                                                    <td class="fw-medium">@driver.CompletedRides</td>
                                                </tr>
                                                rank++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state text-center py-4">
                                <i data-lucide="star" class="mx-auto text-muted mb-2" style="width: 48px; height: 48px;" aria-hidden="true"></i>
                                <p class="text-muted mb-0">No rated drivers yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Drivers by Rides -->
            <div class="col-12 col-xl-4">
                <div class="data-card">
                    <div class="card-header">
                        <h3 class="h5 fw-bold mb-0">Top Drivers by Rides</h3>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.TopDriversByRides != null && Model.TopDriversByRides.Any())
                        {
                            <div class="table-responsive">
                                <table class="data-table" role="grid">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Driver</th>
                                            <th scope="col">Total Rides</th>
                                            <th scope="col">Rating</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rank = 1;
                                            foreach (var driver in Model.TopDriversByRides)
                                            {
                                                <tr>
                                                    <td><span class="rank-badge">#@rank</span></td>
                                                    <td>
                                                        <div class="driver-info">
                                                            <span class="driver-name">@driver.FullName</span>
                                                            <small class="text-muted d-block">@driver.VehicleInfo</small>
                                                        </div>
                                                    </td>
                                                    <td class="fw-medium text-primary">@driver.TotalRides</td>
                                                    <td>
                                                        <div class="rating-display">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i data-lucide="star" class="@(i <= Math.Round(driver.AverageRating) ? "fill text-warning" : "text-muted")" aria-hidden="true"></i>
                                                            }
                                                            <span class="ms-1 text-sm">@driver.AverageRating.ToString("0.0")</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                rank++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state text-center py-4">
                                <i data-lucide="car" class="mx-auto text-muted mb-2" style="width: 48px; height: 48px;" aria-hidden="true"></i>
                                <p class="text-muted mb-0">No driver data yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Drivers by Earnings -->
            <div class="col-12 col-xl-4">
                <div class="data-card">
                    <div class="card-header">
                        <h3 class="h5 fw-bold mb-0">Top Drivers by Earnings</h3>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.TopDriversByEarnings != null && Model.TopDriversByEarnings.Any())
                        {
                            <div class="table-responsive">
                                <table class="data-table" role="grid">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Driver</th>
                                            <th scope="col">Earnings</th>
                                            <th scope="col">Rides</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rank = 1;
                                            foreach (var driver in Model.TopDriversByEarnings)
                                            {
                                                <tr>
                                                    <td><span class="rank-badge">#@rank</span></td>
                                                    <td>
                                                        <div class="driver-info">
                                                            <span class="driver-name">@driver.FullName</span>
                                                            <small class="text-muted d-block">@driver.VehicleInfo</small>
                                                        </div>
                                                    </td>
                                                    <td class="fw-medium text-success">@driver.TotalEarnings.ToString("C0")</td>
                                                    <td class="fw-medium">@driver.CompletedRides</td>
                                                </tr>
                                                rank++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state text-center py-4">
                                <i data-lucide="dollar-sign" class="mx-auto text-muted mb-2" style="width: 48px; height: 48px;" aria-hidden="true"></i>
                                <p class="text-muted mb-0">No earnings data yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- User Growth & Revenue -->
        <div class="row g-4">
            <div class="col-12 col-xl-6">
                <div class="chart-card">
                    <div class="chart-header">
                        <h3 class="h5 fw-bold mb-0">User Growth</h3>
                    </div>
                    <div class="chart-wrapper" style="height: 280px;">
                        <canvas id="userGrowthChart" aria-label="User growth area chart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6">
                <div class="chart-card">
                    <div class="chart-header">
                        <h3 class="h5 fw-bold mb-0">Revenue Overview</h3>
                    </div>
                    <div class="chart-wrapper" style="height: 280px;">
                        <canvas id="revenueChart" aria-label="Revenue bar chart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .page-header {
            padding: var(--space-12) 0 var(--space-8);
            border-bottom: 1px solid var(--color-border-default);
            margin-bottom: var(--space-8);
        }
        .breadcrumb {
            background: transparent;
            padding: 0;
        }
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: var(--color-text-disabled);
        }
        .breadcrumb-item a {
            text-decoration: none;
            transition: color var(--transition-fast);
        }
        .breadcrumb-item a:hover {
            color: var(--color-brand-primary);
        }

        .dashboard-page {
            padding: var(--space-8) 0 var(--space-16);
        }

        /* Metrics Grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-4);
        }
        @@media (min-width: 768px) {
            .metrics-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }
        @@media (min-width: 1200px) {
            .metrics-grid {
                grid-template-columns: repeat(8, 1fr);
            }
        }

        .metric-card {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-2xl);
            padding: var(--space-6);
            display: flex;
            align-items: flex-start;
            gap: var(--space-4);
            transition: all var(--transition-base);
        }
        .metric-card:hover {
            border-color: var(--color-border-emphasis);
            transform: translateY(-2px);
            box-shadow: var(--shadow-xl);
        }

        .metric-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-xl);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .metric-icon i {
            width: 24px;
            height: 24px;
            color: var(--color-text-inverse);
        }
        .metric-icon.bg-primary { background: var(--gradient-primary); }
        .metric-icon.bg-success { background: var(--gradient-success); }
        .metric-icon.bg-danger { background: var(--gradient-danger); }
        .metric-icon.bg-info { background: var(--gradient-info); }
        .metric-icon.bg-secondary { background: var(--gradient-secondary); }
        .metric-icon.bg-warning { background: var(--gradient-warning); }
        .metric-icon.bg-success-alt { background: var(--gradient-success); }
        .metric-icon.bg-dark { background: var(--gradient-dark); }

        .metric-content {
            flex: 1;
            min-width: 0;
        }
        .metric-label {
            margin: 0;
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .metric-value {
            margin: var(--space-1) 0 var(--space-2);
            font-size: var(--font-size-3xl);
            font-weight: var(--font-weight-bold);
            color: var(--color-text-primary);
            line-height: 1.2;
        }
        .metric-trend {
            display: inline-flex;
            align-items: center;
            gap: var(--space-1);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-medium);
        }
        .metric-trend i {
            width: 14px;
            height: 14px;
        }
        .metric-trend.positive { color: var(--color-success); }
        .metric-trend.negative { color: var(--color-danger); }
        .metric-trend.neutral { color: var(--color-text-muted); }

        /* Cards */
        .chart-card, .data-card {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-2xl);
            overflow: hidden;
        }

        .chart-header, .card-header {
            padding: var(--space-5) var(--space-6);
            border-bottom: 1px solid var(--color-border-default);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chart-legend {
            display: flex;
            gap: var(--space-4);
        }
        .legend-item {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            font-size: var(--font-size-sm);
            color: var(--color-text-muted);
        }
        .legend-color {
            width: 10px;
            height: 10px;
            border-radius: var(--radius-sm);
        }

        .chart-wrapper {
            padding: var(--space-6);
            position: relative;
        }

        .card-body {
            padding: var(--space-6);
        }

        .card-actions {
            display: flex;
            gap: var(--space-2);
        }

        .btn-outline-secondary {
            border-color: var(--color-border-strong);
            color: var(--color-text-secondary);
        }
        .btn-outline-secondary:hover {
            background: var(--color-bg-tertiary);
            border-color: var(--color-border-emphasis);
            color: var(--color-text-primary);
        }
        .btn-outline-secondary i {
            width: 16px;
            height: 16px;
        }
        .btn-sm {
            padding: var(--space-2) var(--space-3);
            font-size: var(--font-size-sm);
        }

        /* Data Table */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: var(--font-size-sm);
        }
        .data-table thead th {
            padding: var(--space-4) var(--space-6);
            text-align: left;
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-muted);
            font-size: var(--font-size-xs);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--color-border-default);
            background: var(--color-bg-tertiary);
        }
        .data-table tbody td {
            padding: var(--space-4) var(--space-6);
            border-bottom: 1px solid var(--color-border-default);
            color: var(--color-text-secondary);
            vertical-align: middle;
        }
        .data-table tbody tr:last-child td {
            border-bottom: none;
        }
        .data-table tbody tr:hover td {
            background: var(--color-bg-tertiary);
        }

        .rank-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: var(--radius-md);
            background: var(--color-brand-primary-light);
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-sm);
        }
        .rank-badge:nth-child(1) { background: var(--color-warning-light); color: var(--color-warning); }
        .rank-badge:nth-child(2) { background: var(--color-secondary-light); color: var(--color-secondary); }
        .rank-badge:nth-child(3) { background: var(--color-warning-light); color: var(--color-warning); }

        .route-info {
            display: flex;
            align-items: center;
            gap: var(--space-2);
        }
        .route-start { font-weight: var(--font-weight-medium); }
        .route-arrow {
            width: 16px;
            height: 16px;
            color: var(--color-text-disabled);
        }
        .route-end { color: var(--color-text-muted); }

        .progress-mini {
            height: 6px;
            background: var(--color-border-default);
            border-radius: var(--radius-full);
            overflow: hidden;
        }
        .progress-bar {
            height: 100%;
            border-radius: var(--radius-full);
            transition: width 0.5s ease;
        }

        .rating-display {
            display: inline-flex;
            align-items: center;
            gap: var(--space-1);
        }
        .rating-display i {
            width: 14px;
            height: 14px;
        }
        .rating-display .fill { color: var(--color-warning); }
        .rating-display .text-warning { color: var(--color-warning); }
        .rating-display .text-muted { color: var(--color-text-muted); }

        .text-sm { font-size: var(--font-size-sm); }
        .fw-medium { font-weight: var(--font-weight-medium); }
        .ms-1 { margin-left: var(--space-1); }

        /* Empty State */
        .empty-state {
            padding: var(--space-12) var(--space-6);
        }
        .empty-state i { color: var(--color-text-disabled); }
        .empty-state h4 { color: var(--color-text-primary); }
        .empty-state p { color: var(--color-text-muted); }

        /* Form Select */
        .form-select {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            color: var(--color-text-primary);
            padding: var(--space-2) var(--space-6) var(--space-2) var(--space-3);
            font-size: var(--font-size-sm);
        }
        .form-select:focus {
            border-color: var(--color-brand-primary);
            box-shadow: 0 0 0 3px var(--color-brand-primary-light);
        }

        /* Responsive */
        @@media (max-width: 767px) {
            .page-header {
                padding: var(--space-8) 0 var(--space-6);
            }
            .metric-card {
                padding: var(--space-4);
            }
            .metric-value {
                font-size: var(--font-size-2xl);
            }
            .chart-header, .card-header {
                flex-direction: column;
                align-items: flex-start;
            }
            .data-table thead {
                display: none;
            }
            .data-table, .data-table tbody, .data-table tr, .data-table td {
                display: block;
                width: 100%;
            }
            .data-table tr {
                padding: var(--space-4) var(--space-6);
                border-bottom: 1px solid var(--color-border-default);
            }
            .data-table td {
                padding: var(--space-2) 0;
                border: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .data-table td::before {
                content: attr(data-label);
                font-weight: var(--font-weight-medium);
                color: var(--color-text-muted);
                font-size: var(--font-size-xs);
                text-transform: uppercase;
            }
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Parse model data for charts
            const ridesTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RidesTrendData));
            const userGrowthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserGrowthData));
            const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData));

            const colors = {
                primary: 'var(--color-brand-primary)',
                success: 'var(--color-success)',
                danger: 'var(--color-danger)',
                info: 'var(--color-info)',
                warning: 'var(--color-warning)',
                muted: 'var(--color-text-muted)',
                grid: 'var(--color-border-default)',
                text: 'var(--color-text-secondary)',
                textMuted: 'var(--color-text-muted)'
            };

            // Complaint Resolution Chart
            const complaintCtx = document.getElementById('complaintChart');
            if (complaintCtx) {
                new Chart(complaintCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Open Complaints', 'Resolved Complaints'],
                        datasets: [{
                            data: [@Model.OpenComplaints, @Model.ResolvedComplaints],
                            backgroundColor: [
                                'rgba(37, 99, 235, 0.8)',
                                'rgba(34, 197, 94, 0.8)'
                            ],
                            borderColor: [
                                '#2563eb',
                                '#22c55e'
                            ],
                            borderWidth: 2,
                            borderRadius: 8,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'var(--color-bg-card)',
                                titleColor: 'var(--color-text-primary)',
                                bodyColor: 'var(--color-text-secondary)',
                                borderColor: 'var(--color-border-default)',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: true
                            }
                        },
                        animation: {
                            animateRotate: true,
                            animateScale: true,
                            duration: 1000,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            }

            // Rides Trend Chart - using real data from model
            const trendCtx = document.getElementById('ridesTrendChart');
            if (trendCtx) {
                const labels = ridesTrendData.map(d => d.label);
                const data = ridesTrendData.map(d => d.value);

                const trendChart = new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Rides',
                            data: data,
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 0,
                            pointHoverRadius: 6,
                            pointHoverBackgroundColor: '#2563eb',
                            pointHoverBorderColor: '#fff',
                            pointHoverBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'var(--color-bg-card)',
                                titleColor: 'var(--color-text-primary)',
                                bodyColor: 'var(--color-text-secondary)',
                                borderColor: 'var(--color-border-default)',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: false,
                                callbacks: {
                                    label: ctx => ` ${ctx.raw} rides`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: 'var(--color-text-muted)', maxTicksLimit: 8, font: { size: 11 } }
                            },
                            y: {
                                grid: { color: 'var(--color-border-default)', drawBorder: false },
                                ticks: { color: 'var(--color-text-muted)', font: { size: 11 }, stepSize: Math.max(1, Math.ceil(Math.max(...data) / 5)) },
                                beginAtZero: true
                            }
                        },
                        animation: {
                            duration: 1200,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            }

            // User Growth Chart - using real data from model
            const userGrowthCtx = document.getElementById('userGrowthChart');
            if (userGrowthCtx) {
                const labels = userGrowthData.map(d => d.label);
                const data = userGrowthData.map(d => d.value);

                new Chart(userGrowthCtx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Drivers',
                                data: data, // Using same data for demo - in real app would split
                                borderColor: '#fbbf24',
                                backgroundColor: 'rgba(251, 191, 36, 0.15)',
                                borderWidth: 2,
                                fill: true,
                                tension: 0.4,
                                pointRadius: 0,
                                pointHoverRadius: 5
                            },
                            {
                                label: 'Riders',
                                data: data.map(d => Math.round(d * 2.5)), // Approximation for demo
                                borderColor: '#22c55e',
                                backgroundColor: 'rgba(34, 197, 94, 0.15)',
                                borderWidth: 2,
                                fill: true,
                                tension: 0.4,
                                pointRadius: 0,
                                pointHoverRadius: 5
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { color: 'var(--color-text-muted)', font: { size: 12 }, usePointStyle: true, padding: 20 }
                            },
                            tooltip: {
                                backgroundColor: 'var(--color-bg-card)',
                                titleColor: 'var(--color-text-primary)',
                                bodyColor: 'var(--color-text-secondary)',
                                borderColor: 'var(--color-border-default)',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: true
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: 'var(--color-text-muted)', font: { size: 11 } } },
                            y: { grid: { color: 'var(--color-border-default)', drawBorder: false }, ticks: { color: 'var(--color-text-muted)', font: { size: 11 } }, beginAtZero: true }
                        },
                        animation: { duration: 1200, easing: 'easeOutQuart' }
                    }
                });
            }

            // Revenue Chart - using real data from model
            const revenueCtx = document.getElementById('revenueChart');
            if (revenueCtx) {
                const labels = revenueData.map(d => d.label);
                const data = revenueData.map(d => d.decimalValue);

                new Chart(revenueCtx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Revenue ($)',
                            data: data,
                            backgroundColor: 'rgba(37, 99, 235, 0.8)',
                            borderColor: '#2563eb',
                            borderWidth: 1,
                            borderRadius: 6,
                            borderSkipped: false,
                            maxBarThickness: 40
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'var(--color-bg-card)',
                                titleColor: 'var(--color-text-primary)',
                                bodyColor: 'var(--color-text-secondary)',
                                borderColor: 'var(--color-border-default)',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8,
                                callbacks: {
                                    label: ctx => ` $${ctx.raw.toLocaleString()}`
                                }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: 'var(--color-text-muted)', font: { size: 11 } } },
                            y: {
                                grid: { color: 'var(--color-border-default)', drawBorder: false },
                                ticks: {
                                    color: 'var(--color-text-muted)',
                                    font: { size: 11 },
                                    callback: val => '$' + (val/1000) + 'k'
                                },
                                beginAtZero: true
                            }
                        },
                        animation: { duration: 1000, easing: 'easeOutQuart' }
                    }
                });
            }

            // Animate metric values
            function animateValue(element, start, end, duration) {
                const startTime = performance.now();
                function update(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.floor(start + (end - start) * eased);
                    element.textContent = current.toLocaleString();
                    if (progress < 1) requestAnimationFrame(update);
                }
                requestAnimationFrame(update);
            }

            document.querySelectorAll('.metric-value[data-count]').forEach(el => {
                const count = parseInt(el.dataset.count) || 0;
                animateValue(el, 0, count, 1500);
            });

            // Initialize Lucide icons
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}