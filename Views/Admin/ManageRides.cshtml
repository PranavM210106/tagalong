@model IEnumerable<Tagalong.Models.Entities.Ride>
@{
    ViewData["Title"] = "Manage Rides - Admin Console";
    var rides = Model?.ToList() ?? new List<Tagalong.Models.Entities.Ride>();
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-muted">Admin</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Manage Rides</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 id="page-title" class="display-5 fw-bold mb-1">Ride Management</h1>
                <p class="lead text-muted mb-0">Monitor platform carpool operations, active routes, and safety compliance</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Analytics" class="btn btn-outline-secondary">
                    <i data-lucide="bar-chart-3" class="me-1"></i> Analytics
                </a>
                <a asp-action="ManageUsers" class="btn btn-outline-secondary">
                    <i data-lucide="users" class="me-1"></i> Manage Users
                </a>
            </div>
        </div>
    </div>
</section>

<section class="admin-page py-4">
    <div class="container-fluid px-md-4 px-lg-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i data-lucide="check-circle" style="width:18px;height:18px;"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <div class="card card-elevated" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-2xl); overflow: hidden;">
            <div class="card-header p-4 d-flex justify-content-between align-items-center border-bottom" style="border-color: var(--color-border-default) !important;">
                <h3 class="h5 fw-bold mb-0 text-white">All Platform Rides (@rides.Count)</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="background: transparent;">
                    <thead>
                        <tr class="text-muted text-uppercase text-xs" style="border-color: var(--color-border-default);">
                            <th class="ps-4">Route</th>
                            <th>Driver</th>
                            <th>Vehicle</th>
                            <th>Departure</th>
                            <th>Price / Seats</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ride in rides)
                        {
                            <tr style="border-color: var(--color-border-default);">
                                <td class="ps-4">
                                    <div class="fw-bold text-white">@ride.StartLocation → @ride.EndLocation</div>
                                    <div class="text-muted small">Ride ID: #@ride.RideId</div>
                                </td>
                                <td>
                                    <div class="fw-medium">@(ride.Driver?.FullName ?? "Unknown Driver")</div>
                                    <div class="text-muted small">@(ride.Driver?.Email ?? "")</div>
                                </td>
                                <td>
                                    <div class="small">@(ride.Vehicle != null ? $"{ride.Vehicle.Model} ({ride.Vehicle.VehicleType})" : "Not specified")</div>
                                    <div class="text-muted small">@(ride.Vehicle?.RegistrationNumber ?? "")</div>
                                </td>
                                <td>
                                    <div class="small fw-medium">@ride.DepartureTime.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@ride.DepartureTime.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <div class="text-gold fw-bold">₹@ride.PricePerSeat</div>
                                    <div class="text-muted small">@ride.SeatsAvailable seats left</div>
                                </td>
                                <td>
                                    <span class="badge @(ride.Status == "Active" ? "bg-success" : ride.Status == "Completed" ? "bg-info" : "bg-danger") px-2 py-1">
                                        @ride.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    @if (ride.Status == "Active")
                                    {
                                        <form asp-action="ForceCancelRide" method="post" class="d-inline" onsubmit="return confirm('Force cancel this active ride? Passengers will be alerted.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rideId" value="@ride.RideId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i data-lucide="ban" style="width: 14px; height: 14px;"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

