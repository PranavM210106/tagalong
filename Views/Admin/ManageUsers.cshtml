@model IEnumerable<Tagalong.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users - Admin Console";
    var users = Model?.ToList() ?? new List<Tagalong.Models.Entities.ApplicationUser>();
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-muted">Admin</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Manage Users</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 id="page-title" class="display-5 fw-bold mb-1">User Management</h1>
                <p class="lead text-muted mb-0">Review verified commuters, driver verifications, and account statuses</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Analytics" class="btn btn-outline-secondary">
                    <i data-lucide="bar-chart-3" class="me-1"></i> Analytics
                </a>
                <a asp-action="ManageRides" class="btn btn-outline-secondary">
                    <i data-lucide="car" class="me-1"></i> Manage Rides
                </a>
            </div>
        </div>
    </div>
</section>

<section class="admin-page py-4">
    <div class="container-fluid px-md-4 px-lg-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i data-lucide="check-circle" style="width:18px;height:18px;"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <div class="card card-elevated" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-2xl); overflow: hidden;">
            <div class="card-header p-4 d-flex justify-content-between align-items-center border-bottom" style="border-color: var(--color-border-default) !important;">
                <h3 class="h5 fw-bold mb-0 text-white">Registered Commuters (@users.Count)</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="background: transparent;">
                    <thead>
                        <tr class="text-muted text-uppercase text-xs" style="border-color: var(--color-border-default);">
                            <th class="ps-4">User</th>
                            <th>Email & Phone</th>
                            <th>Verification</th>
                            <th>Joined</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            var isBlocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                            <tr style="border-color: var(--color-border-default);">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle-sm" style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-brand-primary-light); color: var(--color-brand-primary); display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                            @user.FullName?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@user.FullName</div>
                                            <div class="text-muted small">@user.UserName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@user.Email</div>
                                    <div class="text-muted small">@(user.PhoneNumber ?? "No phone recorded")</div>
                                </td>
                                <td>
                                    @if (user.IsVerified)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i data-lucide="shield-check" style="width: 12px; height: 12px;" class="me-1"></i> Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border border-secondary px-2 py-1">
                                            Pending
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        @if (!user.IsVerified)
                                        {
                                            <form asp-action="VerifyDriver" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Verify User">
                                                    <i data-lucide="check" style="width: 14px; height: 14px;"></i> Verify
                                                </button>
                                            </form>
                                        }
                                        <form asp-action="ToggleBlockUser" method="post" class="d-inline" onsubmit="return confirm('@(isBlocked ? "Unblock this user?" : "Block this user from the platform?")');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm @(isBlocked ? "btn-warning" : "btn-outline-danger")">
                                                @(isBlocked ? "Unblock" : "Block")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

