@model IEnumerable<Tagalong.Models.Entities.Complaint>
@{
    ViewData["Title"] = "View Complaints";
}

<h2>View Complaints</h2>

<p>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Admin Dashboard</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Subject</th>
            <th>User</th>
            <th>Related Booking</th>
            <th>Created On</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var complaint in Model)
        {
            <tr>
                <td>@complaint.Subject</td>
                <td>@complaint.User.FullName</td>
                <td>
                    @if (complaint.Booking != null)
                    {
                        @($"{complaint.Booking.Ride.StartLocation} -> {complaint.Booking.Ride.EndLocation}")
                    }
                    else
                    {
                        <em>No specific booking</em>
                    }
                </td>
                <td>@complaint.CreatedOn.ToString("MMM dd, yyyy hh:mm tt")</td>
                <td>
                    <span class="badge @(complaint.Status == "Open" ? "bg-warning" : "bg-success")">
                        @complaint.Status
                    </span>
                </td>
                <td>
                    @if (complaint.Status == "Open" && User.IsInRole("Admin"))
                    {
                        <form asp-action="ResolveComplaint" method="post" class="d-inline">
                            <input type="hidden" name="complaintId" value="@complaint.ComplaintId" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Resolve</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
