@model IEnumerable<Tagalong.Models.Entities.Complaint>
@{
    ViewData["Title"] = "View Complaints";
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-muted">Admin</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Complaints</li>
            </ol>
        </nav>
        <header class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 id="page-title" class="display-5 fw-bold mb-1">Complaints</h1>
                <p class="lead text-muted mb-0">Review and resolve user complaints</p>
            </div>
            <div class="header-actions">
                <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
                    <i data-lucide="arrow-left" class="me-2" aria-hidden="true"></i>
                    Back to Dashboard
                </a>
            </div>
        </header>
    </div>
</section>

<section class="dashboard-page">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                        <div>
                            <h2 class="section-title">
                                <i data-lucide="file-text" aria-hidden="true"></i>
                                All Complaints
                            </h2>
                        </div>
                        <div class="header-actions d-flex gap-2 flex-wrap">
                            <div class="filter-group">
                                <label for="statusFilter" class="form-label visually-hidden">Filter by status</label>
                                <select id="statusFilter" class="form-select form-select-sm" style="width: auto; min-width: 160px;">
                                    <option value="">All Status</option>
                                    <option value="Open">Open</option>
                                    <option value="Resolved">Resolved</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label for="sortFilter" class="form-label visually-hidden">Sort by</label>
                                <select id="sortFilter" class="form-select form-select-sm" style="width: auto; min-width: 160px;">
                                    <option value="newest">Newest First</option>
                                    <option value="oldest">Oldest First</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="data-table mb-0" id="complaintsTable" role="grid" aria-label="Complaints list">
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 30%;">Subject / User</th>
                                        <th scope="col" style="width: 20%;">Related Ride</th>
                                        <th scope="col" style="width: 15%;">Date</th>
                                        <th scope="col" style="width: 15%;">Status</th>
                                        <th scope="col" style="width: 20%;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var complaint in Model)
                                        {
                                            <tr data-complaint-id="@complaint.ComplaintId">
                                                <td>
                                                    <div class="complaint-subject">
                                                        <span class="fw-medium">@complaint.Subject</span>
                                                        <span class="user-name text-muted">@complaint.User?.FullName ?? "Unknown User"</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (complaint.Booking != null)
                                                    {
                                                        <div class="ride-info">
                                                            <span class="route-start">@complaint.Booking.Ride.StartLocation</span>
                                                            <i data-lucide="arrow-right" class="route-arrow" aria-hidden="true"></i>
                                                            <span class="route-end">@complaint.Booking.Ride.EndLocation</span>
                                                        </div>
                                                        <span class="booking-id text-sm text-muted">Booking #@complaint.Booking.BookingId</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No specific booking</span>
                                                    }
                                                </td>
                                                <td>
                                                    <time class="date-cell" datetime="@complaint.CreatedOn.ToString("o")">
                                                        @complaint.CreatedOn.ToString("MMM dd, yyyy")
                                                        <span class="date-time text-muted">@complaint.CreatedOn.ToString("h:mm tt")</span>
                                                    </time>
                                                </td>
                                                <td>
                                                    <span class="status-badge @(complaint.Status == "Open" ? "status-open" : "status-resolved")">
                                                        <i data-lucide="@(complaint.Status == "Open" ? "alert-circle" : "check-circle")" class="me-1" aria-hidden="true"></i>
                                                        @complaint.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="action-buttons">
                                                        @if (complaint.Status == "Open")
                                                        {
                                                            <form asp-action="ResolveComplaint" method="post" class="d-inline resolve-form" data-complaint-id="@complaint.ComplaintId">
                                                                <input type="hidden" name="complaintId" value="@complaint.ComplaintId" />
                                                                <button type="button" class="btn btn-primary btn-sm resolve-btn" data-complaint-id="@complaint.ComplaintId">
                                                                    <i data-lucide="check" class="me-1" aria-hidden="true"></i>
                                                                    Resolve
                                                                </button>
                                                            </form>
                                                        }
                                                        <button type="button" class="btn btn-outline-secondary btn-sm view-btn" data-complaint-id="@complaint.ComplaintId" aria-label="View complaint details">
                                                            <i data-lucide="eye" aria-hidden="true"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="empty-table text-center py-5">
                                                <i data-lucide="inbox" class="mx-auto text-muted mb-3" style="width: 64px; height: 64px;" aria-hidden="true"></i>
                                                <h4 class="h5 fw-bold mb-2">No complaints found</h4>
                                                <p class="text-muted mb-0">All caught up! No complaints to review.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="pagination-wrapper d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3 border-top" style="border-color: var(--color-border-default) !important;">
                            <div class="pagination-info text-sm text-muted">
                                Showing <span id="showingStart">1</span> to <span id="showingEnd">@(Model?.Count() ?? 0)</span> of <span id="totalCount">@(Model?.Count() ?? 0)</span> complaints
                            </div>
                            <nav aria-label="Pagination">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#" aria-label="Previous"><i data-lucide="chevron-left" aria-hidden="true"></i></a>
                                    </li>
                                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#" aria-label="Next"><i data-lucide="chevron-right" aria-hidden="true"></i></a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Complaint Detail Modal -->
<div class="modal fade" id="complaintModal" tabindex="-1" aria-labelledby="complaintModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-2xl);">
            <div class="modal-header" style="border-bottom: 1px solid var(--color-border-default); padding: var(--space-6);">
                <h5 class="modal-title fw-bold" id="complaintModalLabel">Complaint Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="complaint-detail">
                    <div class="detail-header mb-4">
                        <h4 class="detail-subject fw-bold mb-2" id="modalSubject"></h4>
                        <div class="detail-meta d-flex flex-wrap gap-3 text-sm text-muted">
                            <span><i data-lucide="user" class="me-1" aria-hidden="true"></i><span id="modalUser"></span></span>
                            <span><i data-lucide="calendar" class="me-1" aria-hidden="true"></i><span id="modalDate"></span></span>
                            <span><i data-lucide="tag" class="me-1" aria-hidden="true"></i><span id="modalStatus"></span></span>
                        </div>
                    </div>
                    <div class="detail-divider mb-4" style="height: 1px; background: var(--color-border-default);"></div>
                    <div class="detail-section mb-4">
                        <h6 class="text-muted text-sm fw-bold mb-2 text-uppercase">Description</h6>
                        <p class="detail-description text-base" id="modalDescription" style="white-space: pre-wrap;"></p>
                    </div>
                    <div class="detail-section mb-4" id="modalRideSection" style="display: none;">
                        <h6 class="text-muted text-sm fw-bold mb-2 text-uppercase">Related Ride</h6>
                        <div class="ride-detail p-3 rounded" style="background: var(--color-bg-tertiary); border: 1px solid var(--color-border-default);">
                            <div class="ride-route d-flex align-items-center gap-2 mb-2">
                                <span class="fw-medium" id="modalRideStart"></span>
                                <i data-lucide="arrow-right" class="text-muted" aria-hidden="true"></i>
                                <span class="text-muted" id="modalRideEnd"></span>
                            </div>
                            <div class="ride-meta text-sm text-muted">
                                <span id="modalRideDate"></span>
                                <span class="ms-3" id="modalBookingId"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2" style="border-top: 1px solid var(--color-border-default); padding: var(--space-4) var(--space-6);">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary resolve-modal-btn" id="modalResolveBtn" style="display: none;">
                    <i data-lucide="check" class="me-2" aria-hidden="true"></i>
                    Resolve Complaint
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .page-header {
            padding: var(--space-12) 0 var(--space-8);
            border-bottom: 1px solid var(--color-border-default);
            margin-bottom: var(--space-8);
        }
        .breadcrumb {
            background: transparent;
            padding: 0;
        }
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: var(--color-text-disabled);
        }
        .breadcrumb-item a {
            text-decoration: none;
            transition: color var(--transition-fast);
        }
        .breadcrumb-item a:hover {
            color: var(--color-brand-primary);
        }

        .dashboard-page {
            padding: var(--space-8) 0 var(--space-16);
        }

        .header-actions {
            margin-top: var(--space-4);
        }

        @@media (min-width: 768px) {
            .header-actions {
                margin-top: 0;
            }
        }

        .btn-outline-secondary {
            border-color: var(--color-border-strong);
            color: var(--color-text-secondary);
            border-radius: var(--radius-lg);
        }
        .btn-outline-secondary:hover {
            background: var(--color-bg-tertiary);
            border-color: var(--color-border-emphasis);
            color: var(--color-text-primary);
        }
        .btn-outline-secondary i {
            width: 16px;
            height: 16px;
        }

        /* Filters Bar */
        .filters-bar {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-xl);
            padding: var(--space-5);
        }
        .filters-row {
            width: 100%;
        }
        .search-wrapper {
            width: 100%;
        }
        @@media (min-width: 768px) {
            .search-wrapper {
                max-width: 400px;
            }
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        .input-wrapper .form-control {
            padding-left: 2.5rem;
        }
        .input-icon {
            position: absolute;
            left: var(--space-4);
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            color: var(--color-text-disabled);
            pointer-events: none;
            transition: color var(--transition-fast);
            z-index: 2;
        }
        .form-control:focus + .input-icon,
        .form-control:focus ~ .input-icon {
            color: var(--color-brand-primary);
        }

        .form-control {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            color: var(--color-text-primary);
            padding: var(--space-3) var(--space-4);
            font-size: var(--font-size-sm);
            transition: all var(--transition-base);
            height: auto;
        }
        .form-control::placeholder {
            color: var(--color-text-disabled);
        }
        .form-control:focus {
            background: var(--color-bg-tertiary);
            border-color: var(--color-brand-primary);
            box-shadow: 0 0 0 3px var(--color-brand-primary-light);
            color: var(--color-text-primary);
        }

        .form-hint {
            display: block;
            color: var(--color-text-disabled);
            font-size: var(--font-size-xs);
            margin-top: var(--space-1);
        }
        .form-hint kbd {
            background: var(--color-bg-tertiary);
            padding: var(--space-1) var(--space-2);
            border-radius: var(--radius-sm);
            font-size: var(--font-size-xs);
            font-family: inherit;
        }

        /* Table Styles */
        .data-table {
            width: 100%;
            border-collapse: collapse;
        }
        .data-table thead th {
            padding: var(--space-4) var(--space-6);
            text-align: left;
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-muted);
            font-size: var(--font-size-xs);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--color-border-default);
            background: var(--color-bg-card);
            white-space: nowrap;
        }
        .data-table tbody td {
            padding: var(--space-4) var(--space-6);
            border-bottom: 1px solid var(--color-border-default);
            color: var(--color-text-secondary);
            vertical-align: middle;
        }
        .data-table tbody tr:last-child td {
            border-bottom: none;
        }
        .data-table tbody tr:hover td {
            background: var(--color-bg-tertiary);
        }

        .complaint-subject {
            display: flex;
            flex-direction: column;
            gap: var(--space-1);
        }
        .complaint-subject .fw-medium {
            color: var(--color-text-primary);
        }
        .user-name {
            font-size: var(--font-size-sm);
        }

        .ride-info {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            font-size: var(--font-size-sm);
            margin-bottom: var(--space-1);
        }
        .route-start {
            color: var(--color-text-primary);
            font-weight: var(--font-weight-medium);
        }
        .route-arrow {
            width: 16px;
            height: 16px;
            color: var(--color-text-disabled);
            flex-shrink: 0;
        }
        .route-end {
            color: var(--color-text-muted);
        }
        .booking-id {
            font-size: var(--font-size-xs);
        }

        .date-cell {
            display: block;
            line-height: 1.4;
        }
        .date-time {
            display: block;
            font-size: var(--font-size-xs);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            padding: var(--space-1) var(--space-3);
            border-radius: var(--radius-full);
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-semibold);
        }
        .status-badge i {
            width: 14px;
            height: 14px;
        }
        .status-open {
            background: var(--color-warning-light);
            color: var(--color-warning);
        }
        .status-resolved {
            background: var(--color-success-light);
            color: var(--color-success);
        }

        .action-buttons {
            display: flex;
            gap: var(--space-2);
            flex-wrap: wrap;
        }
        .resolve-btn i,
        .view-btn i {
            width: 14px;
            height: 14px;
        }

        .empty-table {
            color: var(--color-text-muted);
        }

        .pagination-wrapper {
            background: var(--color-bg-card);
        }
        .pagination-info {
            color: var(--color-text-muted);
        }
        .pagination .page-link {
            background: transparent;
            border: 1px solid var(--color-border-strong);
            color: var(--color-text-secondary);
            border-radius: var(--radius-md);
            margin: 0 var(--space-1);
            padding: var(--space-2) var(--space-3);
        }
        .pagination .page-link:hover {
            background: var(--color-bg-tertiary);
            border-color: var(--color-brand-primary);
            color: var(--color-text-primary);
        }
        .pagination .page-item.active .page-link {
            background: var(--gradient-primary);
            border-color: transparent;
            color: var(--color-text-inverse);
        }
        .pagination .page-item.disabled .page-link {
            opacity: 0.4;
            pointer-events: none;
        }
        .pagination .page-link i {
            width: 16px;
            height: 16px;
        }

        /* Modal Styles */
        .modal-content {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-2xl);
        }
        .modal-header {
            border-bottom: 1px solid var(--color-border-default);
        }
        .modal-body {
            padding: var(--space-6);
        }
        .modal-footer {
            border-top: 1px solid var(--color-border-default);
        }
        .btn-close-white {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

        .detail-subject {
            color: var(--color-text-primary);
        }
        .detail-meta span {
            display: flex;
            align-items: center;
        }
        .detail-meta i {
            width: 16px;
            height: 16px;
        }
        .detail-description {
            color: var(--color-text-secondary);
            line-height: 1.7;
        }

        /* Toast */
        .toast-alert {
            position: fixed;
            bottom: var(--space-8);
            right: var(--space-8);
            padding: var(--space-4) var(--space-6);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            gap: var(--space-2);
            box-shadow: var(--shadow-xl);
            z-index: 1000;
            animation: slideIn 0.3s ease;
            color: var(--color-text-inverse);
        }
        .toast-success { background: var(--color-success); }
        .toast-error { background: var(--color-danger); }
        @@keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .toast-alert i { width: 20px; height: 20px; }

        /* Responsive */
        @@media (max-width: 767px) {
            .page-header {
                padding: var(--space-8) 0 var(--space-6);
            }
            .data-table thead th,
            .data-table tbody td {
                padding: var(--space-3) var(--space-4);
            }
            .complaint-subject .fw-medium {
                font-size: var(--font-size-sm);
            }
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('complaintsTable');
            const tbody = table?.querySelector('tbody');
            const statusFilter = document.getElementById('statusFilter');
            const sortFilter = document.getElementById('sortFilter');
            const modal = document.getElementById('complaintModal');
            const modalResolveBtn = document.getElementById('modalResolveBtn');

            // View complaint details
            if (tbody) {
                tbody.addEventListener('click', function(e) {
                    const viewBtn = e.target.closest('.view-btn');
                    const resolveBtn = e.target.closest('.resolve-btn');

                    if (viewBtn) {
                        const complaintId = viewBtn.dataset.complaintId;
                        viewComplaint(complaintId);
                    }

                    if (resolveBtn) {
                        const complaintId = resolveBtn.dataset.complaintId;
                        if (confirm('Are you sure you want to resolve this complaint?')) {
                            resolveComplaint(complaintId, resolveBtn);
                        }
                    }
                });
            }

            // Filter by status
            if (statusFilter) {
                statusFilter.addEventListener('change', function() {
                    filterTable();
                });
            }

            // Sort
            if (sortFilter) {
                sortFilter.addEventListener('change', function() {
                    sortTable();
                });
            }

            function filterTable() {
                const status = statusFilter?.value?.toLowerCase();
                const rows = tbody?.querySelectorAll('tr[data-complaint-id]');

                rows?.forEach(row => {
                    const rowStatus = row.querySelector('.status-badge')?.textContent?.trim().toLowerCase();
                    if (!status || rowStatus === status) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
                updatePaginationInfo();
            }

            function sortTable() {
                const sort = sortFilter?.value;
                const rows = Array.from(tbody?.querySelectorAll('tr[data-complaint-id]') || []);

                rows.sort((a, b) => {
                    const dateA = new Date(a.querySelector('time')?.dateTime || 0);
                    const dateB = new Date(b.querySelector('time')?.dateTime || 0);
                    return sort === 'newest' ? dateB - dateA : dateA - dateB;
                });

                rows.forEach(row => tbody.appendChild(row));
            }

            async function viewComplaint(complaintId) {
                try {
                    const response = await fetch(`/Admin/GetComplaint/${complaintId}`);
                    if (!response.ok) throw new Error('Failed to load complaint');

                    const complaint = await response.json();
                    populateModal(complaint);

                    const bsModal = new bootstrap.Modal(modal);
                    bsModal.show();
                } catch (err) {
                    console.error(err);
                    showToast('Failed to load complaint details', 'error');
                }
            }

            function populateModal(complaint) {
                document.getElementById('modalSubject').textContent = complaint.subject;
                document.getElementById('modalUser').textContent = complaint.userName;
                document.getElementById('modalDate').textContent = new Date(complaint.createdOn).toLocaleString();
                document.getElementById('modalStatus').textContent = complaint.status;
                document.getElementById('modalDescription').textContent = complaint.description;

                if (complaint.booking) {
                    document.getElementById('modalRideSection').style.display = 'block';
                    document.getElementById('modalRideStart').textContent = complaint.booking.ride.startLocation;
                    document.getElementById('modalRideEnd').textContent = complaint.booking.ride.endLocation;
                    document.getElementById('modalRideDate').textContent = new Date(complaint.booking.ride.departureTime).toLocaleDateString();
                    document.getElementById('modalBookingId').textContent = 'Booking #' + complaint.booking.bookingId;
                } else {
                    document.getElementById('modalRideSection').style.display = 'none';
                }

                // Show/hide resolve button
                if (complaint.status === 'Open') {
                    modalResolveBtn.style.display = 'inline-flex';
                    modalResolveBtn.onclick = () => {
                        if (confirm('Are you sure you want to resolve this complaint?')) {
                            resolveComplaint(complaint.complaintId, modalResolveBtn, true);
                        }
                    };
                } else {
                    modalResolveBtn.style.display = 'none';
                }
            }

            async function resolveComplaint(complaintId, btn, fromModal = false) {
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i data-lucide="loader" class="me-1 animate-spin" aria-hidden="true"></i> Resolving...';
                if (typeof lucide !== 'undefined') lucide.createIcons({ nodes: btn.querySelectorAll('[data-lucide]') });

                try {
                    const formData = new FormData();
                    formData.append('complaintId', complaintId);

                    const response = await fetch('/Admin/ResolveComplaint', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    });

                    if (response.ok) {
                        showToast('Complaint resolved successfully', 'success');
                        if (fromModal) {
                            bootstrap.Modal.getInstance(modal)?.hide();
                        }
                        // Reload page or update row
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        throw new Error('Failed to resolve');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Failed to resolve complaint', 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                    if (typeof lucide !== 'undefined') lucide.createIcons({ nodes: btn.querySelectorAll('[data-lucide]') });
                }
            }

            function showToast(message, type) {
                const toast = document.createElement('div');
                toast.className = `toast-alert toast-${type}`;
                toast.setAttribute('role', 'alert');
                toast.innerHTML = `<i data-lucide="${type === 'success' ? 'check-circle' : 'alert-circle'}" aria-hidden="true"></i>${escapeHtml(message)}`;
                document.body.appendChild(toast);
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons({ nodes: toast.querySelectorAll('[data-lucide]') });
                }
                setTimeout(() => {
                    toast.style.animation = 'slideIn 0.3s ease reverse';
                    setTimeout(() => toast.remove(), 300);
                }, 4000);
            }

            function updatePaginationInfo() {
                const visibleRows = tbody?.querySelectorAll('tr[data-complaint-id]:not([style*="display: none"])');
                const total = tbody?.querySelectorAll('tr[data-complaint-id]').length || 0;
                const showing = visibleRows?.length || 0;
                document.getElementById('showingStart')?.textContent = showing > 0 ? 1 : 0;
                document.getElementById('showingEnd')?.textContent = showing;
                document.getElementById('totalCount')?.textContent = total;
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // Initialize Lucide icons
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}