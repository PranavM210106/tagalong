@model Tagalong.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<h2>Profile</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                {
                    <img src="@Model.ProfilePicture" alt="Profile Picture" class="rounded-circle mb-3" width="150" height="150">
                }
                else
                {
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3" width="150" height="150">
                        <i class="bi bi-person-circle display-4 text-secondary"></i>
                    </div>
                }
                <h4 class="card-title">@Model.FullName</h4>
                <p class="card-text text-muted">
                    @Model.Email<br />
                    @if (Model.IsVerified)
                    {
                        <span class="badge bg-success">Verified</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Verified</span>
                    }
                </p>
                @if (User.IsInRole("Driver"))
                {
                    <a asp-action="AddVehicle" class="btn btn-outline-primary">Add Vehicle</a>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Account Information</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Full Name:</strong> @Model.FullName</p>
                        <p><strong>Email:</strong> @Model.Email</p>
                        <p><strong>Phone Number:</strong> @Model.PhoneNumber</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Rating Statistics</h5>
                    </div>
                    <div class="card-body text-center">
                        <h2 display="4">@Model.AverageRating.ToString("0.0")</h2>
                        <p class="text-muted">Average Rating</p>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar" role="progressbar" style="width: @((Model.AverageRating/5)*100)%;" aria-valuenow="@Model.AverageRating" aria-valuemin="0" aria-valuemax="5">
                                @Model.AverageRating.ToString("0.0")/5
                            </div>
                        </div>
                        <p class="mt-2"><small>@Model.RatingCount ratings</small></p>
                    </div>
                </div>
            </div>
        </div>
        
        @if (Model.Vehicles.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5>My Vehicles (@Model.Vehicles.Count)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Model</th>
                                    <th>Registration</th>
                                    <th>Seats</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vehicle in Model.Vehicles)
                                {
                                    <tr>
                                        <td>@vehicle.VehicleType</td>
                                        <td>@vehicle.Model</td>
                                        <td>@vehicle.RegistrationNumber</td>
                                        <td>@vehicle.SeatCapacity</td>
                                        <td>
                                            <!-- In a real app, you'd have edit/delete functionality -->
                                            <button class="btn btn-sm btn-outline-secondary">Edit</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        
        <div class="card mb-4">
            <div class="card-header">
                <h5>Recent Ratings Received</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentRatings.Any())
                {
                    <div class="list-group">
                        @foreach (var rating in Model.RecentRatings)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h5 class="mb-1">@rating.Stars stars</h5>
                                    <small class="text-muted">@rating.Booking.BookedOn.ToString("MMM dd, yyyy")</small>
                                </div>
                                <p class="mb-1">@rating.Comment</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No ratings received yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-link">Back to Home</a>
</div>
