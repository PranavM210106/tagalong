@model IEnumerable<Tagalong.Models.Entities.Rating>
@{
    ViewData["Title"] = "All Ratings & Reviews";
    var ratings = Model?.ToList() ?? new List<Tagalong.Models.Entities.Rating>();
    var targetUser = ViewData["TargetUserName"] as string ?? "Commuter";
    var avgRating = ratings.Any() ? (double)ratings.Average(r => r.Stars) : 5.0;
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="Index" class="text-muted">Profile</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Ratings & Reviews</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 id="page-title" class="display-5 fw-bold mb-1">Ratings & Reviews</h1>
                <p class="lead text-muted mb-0">Feedback and trust ratings for @targetUser</p>
            </div>
            <div class="d-flex align-items-center gap-2 p-3 rounded-3" style="background: var(--color-bg-tertiary); border: 1px solid var(--color-border-default);">
                <i data-lucide="star" class="text-gold fill" style="width: 24px; height: 24px;"></i>
                <span class="fs-4 fw-bold text-white">@avgRating.ToString("0.0")</span>
                <span class="text-muted small">(@ratings.Count @(ratings.Count == 1 ? "review" : "reviews"))</span>
            </div>
        </div>
    </div>
</section>

<section class="ratings-page py-4">
    <div class="container-fluid px-md-4 px-lg-5">
        @if (ratings.Any())
        {
            <div class="row g-4">
                @foreach (var rating in ratings)
                {
                    <div class="col-12 col-md-6">
                        <article class="card card-elevated h-100 p-4" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-xl);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center gap-1 text-gold">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i data-lucide="star" class="@(i <= rating.Stars ? "fill text-gold" : "text-muted")" style="width: 18px; height: 18px;"></i>
                                    }
                                    <span class="ms-1 fw-bold text-white small">@rating.Stars.ToString("0.0")</span>
                                </div>
                                <time class="text-muted small">@rating.CreatedOn.ToString("MMM dd, yyyy")</time>
                            </div>
                            <p class="mb-3 text-white-50">"@(string.IsNullOrWhiteSpace(rating.Comment) ? "Smooth and punctual ride!" : rating.Comment)"</p>
                            <div class="pt-3 border-top border-secondary d-flex justify-content-between align-items-center text-xs text-muted">
                                <span>By <strong>@(rating.Rater?.FullName ?? "Verified Commuter")</strong></span>
                                @if (rating.Booking?.Ride != null)
                                {
                                    <span class="text-truncate" style="max-width: 200px;">@rating.Booking.Ride.StartLocation → @rating.Booking.Ride.EndLocation</span>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 card card-elevated p-5" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default);">
                <i data-lucide="star" class="mx-auto text-muted mb-3" style="width: 48px; height: 48px;"></i>
                <h4 class="fw-bold mb-2">No reviews recorded yet</h4>
                <p class="text-muted mb-4">Complete carpools to build your community rating and badge reputation.</p>
                <div>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary">Back to Profile</a>
                </div>
            </div>
        }
    </div>
</section>
