@model Tagalong.Models.Entities.Rating
@{
    ViewData["Title"] = "Rate Your Ride Experience";
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="Index" class="text-muted">Profile</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Rate Ride</li>
            </ol>
        </nav>
        <header>
            <h1 id="page-title" class="display-5 fw-bold mb-1">Rate Your Ride</h1>
            <p class="lead text-muted mb-0">Help keep our community safe and trustworthy by leaving honest feedback</p>
        </header>
    </div>
</section>

<section class="rating-page py-5">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card card-elevated p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="avatar avatar-xl mx-auto mb-3">
                            <i data-lucide="star" style="width: 36px; height: 36px; color: var(--color-text-inverse);"></i>
                        </div>
                        <h2 class="h3 fw-bold mb-2">How was your trip?</h2>
                        <p class="text-muted small">Your feedback helps riders and drivers make great travel choices.</p>
                    </div>

                    <form asp-action="SubmitRating" method="post" id="ratingForm" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BookingId" />
                        <input type="hidden" asp-for="RatedUserId" />
                        <input type="hidden" asp-for="Stars" id="selectedStars" value="5" />

                        <div asp-validation-summary="ModelOnly" class="validation-summary mb-4" role="alert"></div>

                        <!-- Star Rating Selector -->
                        <div class="text-center mb-4">
                            <label class="form-label d-block text-center mb-3">Tap to Rate</label>
                            <div class="star-rating-container d-inline-flex gap-2 justify-content-center" role="radiogroup" aria-label="Star Rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <button type="button" class="star-btn active" data-value="@i" aria-label="@i stars">
                                        <i data-lucide="star" class="star-icon"></i>
                                    </button>
                                }
                            </div>
                            <div class="rating-feedback-text mt-2 fw-semibold text-gold" id="ratingLabel">Excellent (5 Stars)</div>
                            <span asp-validation-for="Stars" class="form-error"></span>
                        </div>

                        <!-- Comment Area -->
                        <div class="form-group mb-4">
                            <label asp-for="Comment" class="form-label">Feedback / Notes (Optional)</label>
                            <textarea asp-for="Comment" class="form-control" rows="4" maxlength="500" placeholder="Tell us about the vehicle condition, punctuality, or conversation..."></textarea>
                            <span asp-validation-for="Comment" class="form-error"></span>
                        </div>

                        <!-- Quick Tags -->
                        <div class="quick-tags mb-4">
                            <label class="form-label d-block mb-2">What stood out?</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="badge-tag btn btn-xs btn-outline-secondary">⚡ On Time</button>
                                <button type="button" class="badge-tag btn btn-xs btn-outline-secondary">🚗 Clean Vehicle</button>
                                <button type="button" class="badge-tag btn btn-xs btn-outline-secondary">🛡️ Safe Driving</button>
                                <button type="button" class="badge-tag btn btn-xs btn-outline-secondary">💬 Great Conversation</button>
                                <button type="button" class="badge-tag btn btn-xs btn-outline-secondary">🎵 Good Music</button>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-secondary flex-grow-1">Cancel</a>
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i data-lucide="check" class="me-1"></i> Submit Review
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .star-rating-container {
            font-size: 2rem;
        }
        .star-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: var(--space-2);
            color: var(--color-gray-600);
            transition: transform var(--transition-fast), color var(--transition-fast);
        }
        .star-btn:hover {
            transform: scale(1.2);
        }
        .star-btn.active, .star-btn.hover {
            color: var(--color-brand-primary);
        }
        .star-btn .star-icon {
            width: 36px;
            height: 36px;
            fill: currentColor;
        }
        .badge-tag.selected {
            background: var(--color-brand-primary-light);
            border-color: var(--color-brand-primary);
            color: var(--color-brand-primary);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const starButtons = document.querySelectorAll('.star-btn');
            const hiddenStarsInput = document.getElementById('selectedStars');
            const ratingLabel = document.getElementById('ratingLabel');
            const labels = {
                1: 'Poor (1 Star)',
                2: 'Fair (2 Stars)',
                3: 'Good (3 Stars)',
                4: 'Very Good (4 Stars)',
                5: 'Excellent (5 Stars)'
            };

            function updateStars(val) {
                hiddenStarsInput.value = val;
                ratingLabel.textContent = labels[val] || `${val} Stars`;
                starButtons.forEach(btn => {
                    const btnVal = parseInt(btn.dataset.value);
                    if (btnVal <= val) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
            }

            starButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    updateStars(parseInt(this.dataset.value));
                });
                btn.addEventListener('mouseenter', function() {
                    const val = parseInt(this.dataset.value);
                    starButtons.forEach(b => {
                        if (parseInt(b.dataset.value) <= val) {
                            b.classList.add('hover');
                        } else {
                            b.classList.remove('hover');
                        }
                    });
                });
                btn.addEventListener('mouseleave', function() {
                    starButtons.forEach(b => b.classList.remove('hover'));
                });
            });

            // Quick tag toggle
            document.querySelectorAll('.badge-tag').forEach(tag => {
                tag.addEventListener('click', function() {
                    this.classList.toggle('selected');
                    const commentBox = document.querySelector('textarea[name="Comment"]');
                    const text = this.textContent.trim().replace(/^[^a-zA-Z0-9]+/, '');
                    if (this.classList.contains('selected')) {
                        commentBox.value = commentBox.value ? `${commentBox.value}, ${text}` : text;
                    }
                });
            });
        });
    </script>
}

