@using Microsoft.AspNetCore.Identity
@using Tagalong.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                <div class="avatar avatar-sm">
                    @if (!string.IsNullOrEmpty(UserManager.GetUserAsync(User).Result?.ProfilePicture))
                    {
                        <img src="@UserManager.GetUserAsync(User).Result.ProfilePicture" alt="" class="rounded-circle" />
                    }
                    else
                    {
                        <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center">
                            <i data-lucide="user" class="avatar-icon" aria-hidden="true"></i>
                        </div>
                    }
                </div>
                <span class="d-none d-md-inline fw-medium">@UserManager.GetUserName(User)</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li>
                    <h6 class="dropdown-header">Account</h6>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Profile" asp-action="Index">
                        <i data-lucide="user" class="dropdown-icon" aria-hidden="true"></i>
                        Profile
                    </a>
                </li>
                @if (User.IsInRole("Driver"))
                {
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Profile" asp-action="AddVehicle">
                            <i data-lucide="car" class="dropdown-icon" aria-hidden="true"></i>
                            My Vehicles
                        </a>
                    </li>
                }
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Bookings" asp-action="MyRides">
                        <i data-lucide="calendar" class="dropdown-icon" aria-hidden="true"></i>
                        My Rides
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <h6 class="dropdown-header">Admin</h6>
                    </li>
                    <li>
                        <a class="dropdown-item d-flex align-items-center gap-2" asp-area="" asp-controller="Admin" asp-action="Index">
                            <i data-lucide="layout-dashboard" class="dropdown-icon" aria-hidden="true"></i>
                            Dashboard
                        </a>
                    </li>
                }
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2 text-danger">
                            <i data-lucide="log-out" class="dropdown-icon" aria-hidden="true"></i>
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn btn-outline-primary btn-sm ms-2" asp-area="" asp-controller="Account" asp-action="Login">
                <i data-lucide="log-in" class="nav-icon me-1" aria-hidden="true"></i>
                <span>Login</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn btn-primary btn-sm ms-2" asp-area="" asp-controller="Account" asp-action="Register">
                <i data-lucide="user-plus" class="nav-icon me-1" aria-hidden="true"></i>
                <span>Register</span>
            </a>
        </li>
    }
</ul>