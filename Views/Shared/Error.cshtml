@model ErrorViewModel
@{
    ViewData["Title"] = "Error - Tagalong";
}

<section class="error-page min-vh-75 d-flex align-items-center justify-content-center py-5">
    <div class="container-fluid px-4">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 text-center">
                <div class="card card-elevated p-5" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-2xl);">
                    <div class="p-4 rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-4" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; width: 80px; height: 80px;">
                        <i data-lucide="alert-octagon" style="width: 44px; height: 44px;"></i>
                    </div>

                    <h1 class="display-6 fw-bold text-white mb-2">Commute Interrupted</h1>
                    <p class="text-muted mb-4 leading-relaxed">
                        An unexpected issue occurred while processing your travel request. Our mobility routing engine has logged this event.
                    </p>

                    @if (Model != null && Model.ShowRequestId)
                    {
                        <div class="p-3 rounded-3 mb-4 text-start font-monospace small" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.08);">
                            <span class="text-muted">Incident Trace ID:</span> <span class="text-gold">@Model.RequestId</span>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-3 justify-content-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i data-lucide="home" class="me-1"></i> Return Home
                        </a>
                        <a asp-controller="Rides" asp-action="Find" class="btn btn-outline-secondary px-4 py-2">
                            <i data-lucide="search" class="me-1"></i> Search Rides
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
