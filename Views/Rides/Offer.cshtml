@model Tagalong.Models.ViewModels.OfferRideViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Offer a Ride";
    var defaultGMapKey = Configuration["GoogleMaps:ApiKey"] ?? "";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .leaflet-container {
            background: #090a0f !important;
        }
        #offerMap .leaflet-tile {
            filter: brightness(0.65) invert(1) contrast(2.6) hue-rotate(205deg) saturate(0.35) brightness(0.85) !important;
        }
        .leaflet-control-zoom a {
            background: #18181b !important;
            color: #ffffff !important;
            border-color: rgba(255, 255, 255, 0.15) !important;
        }
        .leaflet-control-zoom a:hover {
            color: #facc15 !important;
        }
        .leaflet-control-attribution {
            background: rgba(9, 10, 15, 0.85) !important;
            color: rgba(255, 255, 255, 0.5) !important;
            font-size: 10px !important;
        }
        .leaflet-control-attribution a {
            color: #eab308 !important;
        }
        .page-header {
            padding: var(--space-12) 0 var(--space-8);
            border-bottom: 1px solid var(--color-border-default);
            margin-bottom: var(--space-8);
        }
        .breadcrumb {
            background: transparent;
            padding: 0;
        }
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: var(--color-text-disabled);
        }
        .breadcrumb-item a {
            text-decoration: none;
            transition: color var(--transition-fast);
        }
        .breadcrumb-item a:hover {
            color: var(--color-brand-primary);
        }
        .form-page {
            padding: var(--space-8) 0 var(--space-16);
        }
        .ride-form {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-2xl);
            padding: var(--space-8);
        }
        .form-section {
            padding-bottom: var(--space-6);
            border-bottom: 1px solid var(--color-border-default);
            margin-bottom: var(--space-6);
        }
        .form-section:last-of-type {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .section-title {
            display: inline-flex;
            align-items: center;
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-5);
            padding-bottom: var(--space-3);
            border-bottom: 2px solid var(--color-brand-primary);
        }
        .section-title i {
            width: 20px;
            height: 20px;
        }
        .form-label {
            display: block;
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: var(--space-2);
        }
        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        .input-wrapper .form-control {
            padding-left: 3rem;
        }
        .input-wrapper .input-prefix {
            position: absolute;
            left: 1rem;
            color: var(--color-brand-primary);
            font-weight: var(--font-weight-bold);
            font-size: 1.1rem;
            z-index: 2;
        }
        .input-wrapper .input-prefix + .form-control {
            padding-left: 2.75rem;
        }
        .input-icon {
            position: absolute;
            left: var(--space-4);
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            color: var(--color-text-disabled);
            pointer-events: none;
            transition: color var(--transition-fast);
            z-index: 2;
        }
        .location-btn {
            position: absolute;
            right: var(--space-4);
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: var(--space-2);
            color: var(--color-text-disabled);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-md);
            transition: all var(--transition-fast);
            z-index: 2;
        }
        .location-btn:hover {
            background: var(--color-brand-primary-light);
            color: var(--color-brand-primary);
        }
        .form-control {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            color: var(--color-text-primary);
            padding: var(--space-3) var(--space-4);
            font-size: var(--font-size-base);
            transition: all var(--transition-base);
            height: auto;
        }
        .form-control::placeholder {
            color: var(--color-text-disabled);
        }
        .form-control:focus {
            background: var(--color-bg-tertiary);
            border-color: var(--color-brand-primary);
            box-shadow: 0 0 0 3px var(--color-brand-primary-light);
            color: var(--color-text-primary);
        }
        .form-error {
            display: block;
            color: var(--color-danger);
            font-size: var(--font-size-xs);
            margin-top: var(--space-1);
        }
        .validation-summary {
            background: var(--color-danger-light);
            border: 1px solid rgba(220, 38, 38, 0.3);
            border-radius: var(--radius-lg);
            padding: var(--space-4);
            color: var(--color-danger);
        }
        .form-hint {
            display: block;
            color: var(--color-text-disabled);
            font-size: var(--font-size-xs);
            margin-top: var(--space-1);
        }

        /* Map styling */
        .route-map-wrapper {
            margin-top: var(--space-5);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-xl);
            overflow: hidden;
            background: #111;
            box-shadow: var(--shadow-md);
        }
        .map-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--space-2);
            padding: var(--space-3) var(--space-4);
            background: var(--color-bg-tertiary);
            border-bottom: 1px solid var(--color-border-default);
        }
        .map-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-medium);
            padding: 4px 10px;
            border-radius: var(--radius-full);
            background: rgba(255, 255, 255, 0.06);
            color: var(--color-text-secondary);
        }
        .map-badge.highlight {
            background: var(--color-brand-primary-light);
            color: var(--color-brand-primary);
            border: 1px solid rgba(234, 179, 8, 0.3);
        }
        #offerMap, #googleMapContainer {
            height: 330px;
            width: 100%;
            z-index: 1;
            background: #121212;
        }
        .leaflet-container {
            background: #121212 !important;
            font-family: inherit;
        }

        /* Custom Map Pins */
        .custom-map-pin {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(0,0,0,0.8);
            font-size: 16px;
            position: relative;
        }
        .custom-map-pin.pickup {
            background: #16a34a;
            border: 2px solid #ffffff;
            color: #fff;
        }
        .custom-map-pin.dropoff {
            background: #eab308;
            border: 2px solid #ffffff;
            color: #000;
        }
        .pulse-ring {
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(234, 179, 8, 0.6);
            animation: mapPulse 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
        }
        @@keyframes mapPulse {
            0% { transform: scale(0.9); opacity: 1; }
            100% { transform: scale(1.8); opacity: 0; }
        }

        /* Quick Location Chips */
        .quick-locations {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2);
            margin-top: var(--space-3);
        }
        .quick-chip {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-default);
            color: var(--color-text-secondary);
            font-size: var(--font-size-xs);
            padding: 4px 10px;
            border-radius: var(--radius-full);
            cursor: pointer;
            transition: all var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .quick-chip:hover {
            border-color: var(--color-brand-primary);
            color: var(--color-brand-primary);
            background: var(--color-brand-primary-light);
        }

        /* Vehicle Selection Options */
        .vehicle-selection-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: var(--space-4);
        }
        .vehicle-selection-option {
            display: block;
            cursor: pointer;
        }
        .vehicle-selection-input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }
        .vehicle-selection-card {
            display: flex;
            align-items: center;
            gap: var(--space-4);
            padding: var(--space-5);
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-xl);
            transition: all var(--transition-base);
        }
        .vehicle-selection-option:hover .vehicle-selection-card {
            border-color: var(--color-brand-primary);
        }
        .vehicle-selection-input:checked + .vehicle-selection-card {
            border-color: var(--color-brand-primary);
            background: var(--color-brand-primary-light);
            box-shadow: 0 0 15px rgba(234, 179, 8, 0.15);
        }
        .vehicle-selection-icon {
            width: 52px;
            height: 52px;
            background: var(--gradient-primary);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #030303;
        }
        .vehicle-selection-model {
            color: var(--color-text-primary);
            font-size: var(--font-size-base);
            font-weight: var(--font-weight-semibold);
        }

        /* Empty Vehicle State */
        .empty-vehicle-state {
            background: var(--color-bg-tertiary);
            border: 1px dashed var(--color-border-strong);
            border-radius: var(--radius-xl);
        }
        .empty-vehicle-state i {
            color: var(--color-text-disabled);
        }

        /* Form Actions */
        .form-actions {
            padding-top: var(--space-5);
            margin-top: var(--space-5);
            border-top: 1px solid var(--color-border-default);
        }
        .auth-submit {
            border-radius: var(--radius-lg);
            background: var(--gradient-primary);
            border: none;
            color: #030303;
            font-weight: var(--font-weight-bold);
            transition: all var(--transition-base);
            min-width: 200px;
        }
        .auth-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: var(--shadow-glow);
            color: #000;
        }

        /* Modal styling */
        .modal-content.dark-modal {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-2xl);
            color: var(--color-text-primary);
        }
        .modal-header.dark-modal-header {
            border-bottom: 1px solid var(--color-border-default);
            padding: var(--space-5) var(--space-6);
        }
        .modal-footer.dark-modal-footer {
            border-top: 1px solid var(--color-border-default);
            padding: var(--space-4) var(--space-6);
        }
        .btn-close-white {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
        .pac-container {
            background-color: #1a1a1a;
            border: 1px solid rgba(234, 179, 8, 0.4);
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.8);
            font-family: inherit;
            z-index: 99999;
        }
        .pac-item {
            color: #f5f5f5;
            border-top: 1px solid rgba(255,255,255,0.06);
            padding: 8px 12px;
            cursor: pointer;
        }
        .pac-item:hover, .pac-item-selected {
            background-color: rgba(234, 179, 8, 0.15);
        }
        .pac-item-query {
            color: #facc15;
            font-size: 14px;
        }
        .pac-matched {
            font-weight: bold;
            color: #ffffff;
        }
    </style>
}

<!-- Page Header -->
<header class="page-header">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="breadcrumb mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-muted">
                        <i data-lucide="home" class="me-1" style="width:16px;height:16px;"></i>Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Rides" asp-action="Find" class="text-muted">Rides</a>
                </li>
                <li class="breadcrumb-item active text-gold fw-medium" aria-current="page">Offer a Ride</li>
            </ol>
        </nav>
        <h1 class="h2 mb-0 fw-semibold">Offer a Ride</h1>
        <p class="text-muted mt-1">Share empty seats on your route with live GPS navigation and earn in Rupees (₹)</p>
    </div>
</header>

<!-- Form Page -->
<main class="form-page">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <form class="ride-form" method="post" novalidate id="offerRideForm">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-summary mb-4" role="alert">
                            <i data-lucide="alert-circle" class="me-2" style="width:18px;height:18px;"></i>
                            <strong>Please fix the following errors:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Hidden lat/lng fields -->
                    <input type="hidden" id="StartLat" name="StartLat" value="@(Model.StartLat != 0 ? Model.StartLat : 22.3667)" />
                    <input type="hidden" id="StartLng" name="StartLng" value="@(Model.StartLng != 0 ? Model.StartLng : 70.7972)" />
                    <input type="hidden" id="EndLat" name="EndLat" value="@(Model.EndLat != 0 ? Model.EndLat : 22.3168)" />
                    <input type="hidden" id="EndLng" name="EndLng" value="@(Model.EndLng != 0 ? Model.EndLng : 70.7813)" />

                    <!-- Trip Details Section -->
                    <fieldset class="form-section">
                        <legend class="section-title">
                            <i data-lucide="map-pin" aria-hidden="true"></i>
                            Trip Details & Route Map
                        </legend>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="StartLocation">Departure Location <span class="text-danger">*</span></label>
                                <div class="input-wrapper">
                                    <i data-lucide="navigation" class="input-icon" aria-hidden="true"></i>
                                    <input type="text" class="form-control" id="StartLocation" name="StartLocation" placeholder="Where are you starting from?" value="@Model.StartLocation" required autocomplete="off" />
                                    <button type="button" class="location-btn" id="btnCurrentLocation" title="Use current GPS location" aria-label="Use current location for departure">
                                        <i data-lucide="crosshair" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="StartLocation" class="form-error"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="EndLocation">Destination <span class="text-danger">*</span></label>
                                <div class="input-wrapper">
                                    <i data-lucide="flag" class="input-icon" aria-hidden="true"></i>
                                    <input type="text" class="form-control" id="EndLocation" name="EndLocation" placeholder="Where are you going?" value="@Model.EndLocation" required autocomplete="off" />
                                </div>
                                <span asp-validation-for="EndLocation" class="form-error"></span>
                            </div>

                            <!-- Quick stops chips -->
                            <div class="col-12">
                                <div class="small text-muted mb-1 d-flex align-items-center gap-1">
                                    <i data-lucide="zap" style="width:14px;height:14px;" class="text-warning"></i>
                                    <span>Quick Pick Popular Stops:</span>
                                </div>
                                <div class="quick-locations">
                                    <button type="button" class="quick-chip" data-name="Marwadi University" data-lat="22.3667" data-lng="70.7972">📍 Marwadi University</button>
                                    <button type="button" class="quick-chip" data-name="Madhapar Chowk" data-lat="22.3168" data-lng="70.7813">📍 Madhapar Chowk</button>
                                    <button type="button" class="quick-chip" data-name="Rajkot Junction" data-lat="22.3115" data-lng="70.8021">🚆 Rajkot Junction</button>
                                    <button type="button" class="quick-chip" data-name="Kalawad Road" data-lat="22.2835" data-lng="70.7712">🛣️ Kalawad Road</button>
                                    <button type="button" class="quick-chip" data-name="Crystal Mall" data-lat="22.2858" data-lng="70.7735">🛍️ Crystal Mall</button>
                                    <button type="button" class="quick-chip" data-name="Rajkot Airport" data-lat="22.3092" data-lng="70.7794">✈️ Airport</button>
                                </div>
                            </div>

                            <!-- Live Route Map (Google Maps API + Resilient Dark Engine) -->
                            <div class="col-12">
                                <div class="route-map-wrapper">
                                    <div class="map-header-bar">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="map-badge highlight">
                                                <i data-lucide="route" style="width:14px;height:14px;"></i>
                                                <span id="routeDistanceChip">Route Preview</span>
                                            </span>
                                            <span class="map-badge" id="routeDurationBadge">
                                                <i data-lucide="clock" style="width:14px;height:14px;"></i>
                                                <span id="routeDurationChip">~20 min</span>
                                            </span>
                                            <span class="map-badge" id="mapEngineStatusBadge">
                                                <i data-lucide="map" style="width:14px;height:14px;" class="text-gold"></i>
                                                <span id="mapEngineName">Live GPS Active</span>
                                            </span>
                                        </div>
                                        <div class="text-muted small d-none d-sm-block">
                                            <span>💡 Click on map to drop Pickup 🟢 or Destination 🏁 pins</span>
                                        </div>
                                    </div>
                                    <div id="offerMap"></div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="DepartureTime">Departure Date & Time <span class="text-danger">*</span></label>
                                <div class="input-wrapper">
                                    <i data-lucide="calendar-clock" class="input-icon" aria-hidden="true"></i>
                                    <input type="datetime-local" class="form-control" id="DepartureTime" name="DepartureTime" value="@(Model.DepartureTime > DateTime.MinValue ? Model.DepartureTime.ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm"))" required />
                                </div>
                                <span asp-validation-for="DepartureTime" class="form-error"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="SeatsAvailable">Available Seats <span class="text-danger">*</span></label>
                                <div class="input-wrapper">
                                    <i data-lucide="users" class="input-icon" aria-hidden="true"></i>
                                    <input type="number" class="form-control" id="SeatsAvailable" name="SeatsAvailable" min="1" max="8" value="@(Model.SeatsAvailable > 0 ? Model.SeatsAvailable : 2)" required />
                                </div>
                                <span class="form-hint">Number of passenger seats you want to offer (1-8)</span>
                                <span asp-validation-for="SeatsAvailable" class="form-error"></span>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Vehicle Selection Section -->
                    <fieldset class="form-section">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <legend class="section-title mb-0">
                                <i data-lucide="car" aria-hidden="true"></i>
                                Select Vehicle
                            </legend>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quickAddVehicleModal">
                                <i data-lucide="plus" class="me-1" style="width:14px;height:14px;"></i>Add Another Vehicle
                            </button>
                        </div>

                        <div id="vehicleContainer">
                            @if (Model.Vehicles != null && Model.Vehicles.Any())
                            {
                                <div class="vehicle-selection-options" role="radiogroup" aria-label="Select a vehicle" id="vehicleList">
                                    @foreach (var vehicle in Model.Vehicles)
                                    {
                                        <label class="vehicle-selection-option" id="vehicle-card-@vehicle.VehicleId">
                                            <input type="radio" class="vehicle-selection-input" name="VehicleId" value="@vehicle.VehicleId" @(Model.VehicleId == vehicle.VehicleId || Model.Vehicles.First().VehicleId == vehicle.VehicleId ? "checked" : "") required />
                                            <div class="vehicle-selection-card">
                                                <div class="vehicle-selection-icon" aria-hidden="true">
                                                    <i data-lucide="@(vehicle.VehicleType?.ToLower() == "motorcycle" ? "bike" : "car")" style="width:26px;height:26px;"></i>
                                                </div>
                                                <div class="vehicle-selection-info flex-grow-1">
                                                    <div class="vehicle-selection-model">@vehicle.Model (@vehicle.VehicleType)</div>
                                                    <div class="vehicle-selection-details text-muted small d-flex align-items-center gap-2 mt-1">
                                                        <span><i data-lucide="tag" style="width:13px;height:13px;"></i> @vehicle.RegistrationNumber</span>
                                                        <span><i data-lucide="users" style="width:13px;height:13px;"></i> @vehicle.SeatCapacity seats</span>
                                                    </div>
                                                </div>
                                                <i data-lucide="check-circle" class="vehicle-selection-check text-gold" style="width:22px;height:22px;"></i>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-vehicle-state p-5 text-center" id="emptyVehicleBox">
                                    <i data-lucide="car" class="mb-3 mx-auto" style="width:48px;height:48px; display:block;"></i>
                                    <h4 class="mb-2 fw-semibold">No Vehicles Registered</h4>
                                    <p class="text-muted mb-4">You need to register at least one vehicle before offering rides.</p>
                                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                                        <button type="button" class="btn btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#quickAddVehicleModal">
                                            <i data-lucide="plus" class="me-2" style="width:16px;height:16px;"></i>+ Quick Add Vehicle
                                        </button>
                                        <a asp-controller="Profile" asp-action="AddVehicle" asp-route-returnUrl="/Rides/Offer" class="btn btn-outline-secondary px-4 py-2">
                                            <i data-lucide="external-link" class="me-2" style="width:16px;height:16px;"></i>Vehicle Form Page
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="VehicleId" class="form-error mt-2"></span>
                    </fieldset>

                    <!-- Pricing Section (Rupees ₹ & Live Dynamic Calculation) -->
                    <fieldset class="form-section">
                        <legend class="section-title">
                            <i data-lucide="credit-card" aria-hidden="true"></i>
                            Pricing & Earnings
                        </legend>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="PricePerSeat">Price Per Seat (₹) <span class="text-danger">*</span></label>
                                <div class="input-wrapper">
                                    <span class="input-prefix">₹</span>
                                    <input type="number" class="form-control" id="PricePerSeat" name="PricePerSeat" step="1" min="1" max="5000" value="@(Model.PricePerSeat > 0 ? Model.PricePerSeat : 450)" required />
                                </div>
                                <span class="form-hint">Set a fair price in Indian Rupees (₹) per passenger seat</span>
                                <span asp-validation-for="PricePerSeat" class="form-error"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Estimated Earnings (₹)</label>
                                <div class="input-wrapper">
                                    <span class="input-prefix">₹</span>
                                    <input type="text" class="form-control" id="EstimatedEarnings" readonly value="@((Model.PricePerSeat > 0 && Model.SeatsAvailable > 0 ? Model.PricePerSeat * Model.SeatsAvailable : 900).ToString("F2"))" style="background:var(--color-bg-secondary); color:var(--color-brand-primary); font-weight:700; font-size:1.15rem;" />
                                </div>
                                <span class="form-hint" id="earningsBreakdown">Based on @Model.SeatsAvailable seats @@ ₹@Model.PricePerSeat each</span>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Form Actions -->
                    <div class="form-actions d-flex flex-column flex-sm-row gap-3 justify-content-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-5 py-3">
                            <i data-lucide="x" class="me-2" aria-hidden="true"></i>Cancel
                        </a>
                        <button type="submit" class="btn auth-submit px-5 py-3">
                            <span class="btn-text">
                                <i data-lucide="plus-circle" class="me-2" aria-hidden="true"></i>Publish Ride
                            </span>
                            <span class="btn-loader d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Publishing Ride...
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<!-- Quick Add Vehicle Modal (Inline without page refresh) -->
<div class="modal fade" id="quickAddVehicleModal" tabindex="-1" aria-labelledby="quickAddVehicleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header dark-modal-header">
                <h5 class="modal-title fw-bold" id="quickAddVehicleModalLabel">
                    <i data-lucide="car" class="me-2 text-gold"></i>Register a Vehicle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalAlert" class="alert alert-danger d-none" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" for="modalVehicleType">Vehicle Type</label>
                    <select class="form-control" id="modalVehicleType" required>
                        <option value="Car" selected>Car (Sedan / Hatchback)</option>
                        <option value="SUV">SUV</option>
                        <option value="Van">Van</option>
                        <option value="Motorcycle">Motorcycle</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="modalModel">Model Name</label>
                    <input type="text" class="form-control" id="modalModel" placeholder="e.g. Honda City, Swift, Activa" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="modalRegNumber">Registration Number</label>
                    <input type="text" class="form-control text-uppercase" id="modalRegNumber" placeholder="e.g. GJ-03-AB-1234" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="modalSeatCapacity">Total Seat Capacity (including driver)</label>
                    <input type="number" class="form-control" id="modalSeatCapacity" min="1" max="8" value="4" required />
                    <span class="form-hint">Passenger capacity will be capacity minus 1 for driver</span>
                </div>
            </div>
            <div class="modal-footer dark-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveVehicleModal">
                    <span class="btn-text"><i data-lucide="check" class="me-1"></i>Save Vehicle</span>
                    <span class="btn-loader d-none"><span class="spinner-border spinner-border-sm me-2"></span>Saving...</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Google Maps API Key Modal -->
<div class="modal fade" id="googleApiKeyModal" tabindex="-1" aria-labelledby="googleApiKeyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header dark-modal-header">
                <h5 class="modal-title fw-bold" id="googleApiKeyModalLabel">
                    <i data-lucide="map-pin" class="me-2 text-gold"></i>Google Maps API Settings
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted text-sm mb-3">
                    Tagalong supports <strong>Google Maps JavaScript API & Places Autocomplete</strong> for real-time traffic and address suggestions.
                </p>
                <div class="mb-3">
                    <label class="form-label" for="inputGoogleApiKey">Google Maps API Key</label>
                    <input type="text" class="form-control font-monospace" id="inputGoogleApiKey" placeholder="AIzaSy..." value="@defaultGMapKey" />
                    <span class="form-hint">Leave blank to use the built-in dark vector map engine (no credit card required).</span>
                </div>
            </div>
            <div class="modal-footer dark-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveGMapKey">
                    <i data-lucide="save" class="me-1"></i>Apply Key
                </button>
