</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Min datetime for departure
            const departureInput = document.getElementById('DepartureTime');
            if (departureInput) {
                const now = new Date();
                const pad = n => n.toString().padStart(2, '0');
                const localIso = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
                departureInput.min = localIso;
            }

            // 2. LIVE DYNAMIC EARNINGS CALCULATOR (IN RUPEES ₹)
            const priceInput = document.getElementById('PricePerSeat');
            const seatsInput = document.getElementById('SeatsAvailable');
            const estOutput = document.getElementById('EstimatedEarnings');
            const breakdownEl = document.getElementById('earningsBreakdown');

            function updateEarnings() {
                const price = parseFloat(priceInput ? priceInput.value : 0) || 0;
                const seats = parseInt(seatsInput ? seatsInput.value : 0, 10) || 0;
                const total = (price * seats).toFixed(2);
                if (estOutput) {
                    estOutput.value = total;
                }
                if (breakdownEl) {
                    breakdownEl.textContent = `Based on ${seats} seat${seats !== 1 ? 's' : ''} @@ ₹${price.toFixed(2)} each = ₹${total} total potential earnings`;
                }
            }

            if (priceInput) {
                priceInput.addEventListener('input', updateEarnings);
                priceInput.addEventListener('change', updateEarnings);
                priceInput.addEventListener('keyup', updateEarnings);
            }
            if (seatsInput) {
                seatsInput.addEventListener('input', updateEarnings);
                seatsInput.addEventListener('change', updateEarnings);
                seatsInput.addEventListener('keyup', updateEarnings);
            }
            updateEarnings();

            // 3. GOOGLE MAPS API + DUAL-ENGINE ARCHITECTURE
            const startLatInput = document.getElementById('StartLat');
            const startLngInput = document.getElementById('StartLng');
            const endLatInput = document.getElementById('EndLat');
            const endLngInput = document.getElementById('EndLng');
            const startLocInput = document.getElementById('StartLocation');
            const endLocInput = document.getElementById('EndLocation');
            const routeDistChip = document.getElementById('routeDistanceChip');
            const routeDurChip = document.getElementById('routeDurationChip');
            const mapEngineName = document.getElementById('mapEngineName');

            let gmapKey = localStorage.getItem('tagalong_gmap_key') || '@defaultGMapKey';
            const inputGMapKey = document.getElementById('inputGoogleApiKey');
            if (inputGMapKey && gmapKey) inputGMapKey.value = gmapKey;

            document.getElementById('btnSaveGMapKey')?.addEventListener('click', function() {
                const val = inputGMapKey.value.trim();
                if (val) {
                    localStorage.setItem('tagalong_gmap_key', val);
                } else {
                    localStorage.removeItem('tagalong_gmap_key');
                }
                location.reload();
            });

            // Uber / Rapido Custom Dark Theme Style for Google Maps
            const googleDarkStyle = [
                { "elementType": "geometry", "stylers": [{ "color": "#121212" }] },
                { "elementType": "labels.icon", "stylers": [{ "visibility": "off" }] },
                { "elementType": "labels.text.fill", "stylers": [{ "color": "#757575" }] },
                { "elementType": "labels.text.stroke", "stylers": [{ "color": "#1a1a1a" }] },
                { "featureType": "administrative", "elementType": "geometry", "stylers": [{ "color": "#757575" }] },
                { "featureType": "poi", "elementType": "labels.text.fill", "stylers": [{ "color": "#757575" }] },
                { "featureType": "road", "elementType": "geometry.fill", "stylers": [{ "color": "#242424" }] },
                { "featureType": "road", "elementType": "labels.text.fill", "stylers": [{ "color": "#8a8a8a" }] },
                { "featureType": "road.highway", "elementType": "geometry.fill", "stylers": [{ "color": "#333333" }] },
                { "featureType": "road.highway", "elementType": "geometry.stroke", "stylers": [{ "color": "#eab308" }, { "weight": 0.5 }] },
                { "featureType": "transit", "elementType": "labels.text.fill", "stylers": [{ "color": "#757575" }] },
                { "featureType": "water", "elementType": "geometry", "stylers": [{ "color": "#000000" }] }
            ];

            let googleMap = null;
            let googleDirectionsService = null;
            let googleDirectionsRenderer = null;
            let googlePickupMarker = null;
            let googleDropMarker = null;
            let leafletMap = null;

            function haversineDistance(c1, c2) {
                const R = 6371; // km
                const dLat = (c2[0] - c1[0]) * Math.PI / 180;
                const dLon = (c2[1] - c1[1]) * Math.PI / 180;
                const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                          Math.cos(c1[0] * Math.PI / 180) * Math.cos(c2[0] * Math.PI / 180) *
                          Math.sin(dLon/2) * Math.sin(dLon/2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
                return R * c;
            }

            function tryLoadGoogleMaps(apiKey) {
                if (!apiKey) {
                    initLeafletFallback();
                    return;
                }

                window.gm_authFailure = function() {
                    console.warn('[Tagalong] Google Maps authentication failed. Falling back to Dark Tile Engine.');
                    if (mapEngineName) mapEngineName.textContent = 'Dark Engine (GMap Auth Required)';
                    initLeafletFallback();
                };

                const script = document.createElement('script');
                script.src = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&libraries=places`;
                script.async = true;
                script.defer = true;
                script.onload = function() {
                    initGoogleMapsEngine();
                };
                script.onerror = function() {
                    console.warn('[Tagalong] Google Maps script failed to load. Falling back to Dark Tile Engine.');
                    initLeafletFallback();
                };
                document.head.appendChild(script);
            }

            function initGoogleMapsEngine() {
                try {
                    const centerLat = parseFloat(startLatInput?.value) || 22.34;
                    const centerLng = parseFloat(startLngInput?.value) || 70.79;

                    const mapContainer = document.getElementById('offerMap');
                    googleMap = new google.maps.Map(mapContainer, {
                        center: { lat: centerLat, lng: centerLng },
                        zoom: 12,
                        styles: googleDarkStyle,
                        disableDefaultUI: false,
                        zoomControl: true,
                        mapTypeControl: false,
                        streetViewControl: false,
                        fullscreenControl: false
                    });

                    googleDirectionsService = new google.maps.DirectionsService();
                    googleDirectionsRenderer = new google.maps.DirectionsRenderer({
                        map: googleMap,
                        suppressMarkers: true,
                        polylineOptions: {
                            strokeColor: '#facc15',
                            strokeWeight: 5,
                            strokeOpacity: 0.9
                        }
                    });

                    if (mapEngineName) mapEngineName.textContent = 'Google Maps Active';

                    // Google Places Autocomplete on Departure
                    if (startLocInput && google.maps.places) {
                        const autoStart = new google.maps.places.Autocomplete(startLocInput);
                        autoStart.bindTo('bounds', googleMap);
                        autoStart.addListener('place_changed', function() {
                            const place = autoStart.getPlace();
                            if (place.geometry && place.geometry.location) {
                                const lat = place.geometry.location.lat();
                                const lng = place.geometry.location.lng();
                                startLatInput.value = lat.toFixed(6);
                                startLngInput.value = lng.toFixed(6);
                                updateGoogleRoute();
                            }
                        });
                    }

                    // Google Places Autocomplete on Destination
                    if (endLocInput && google.maps.places) {
                        const autoEnd = new google.maps.places.Autocomplete(endLocInput);
                        autoEnd.bindTo('bounds', googleMap);
                        autoEnd.addListener('place_changed', function() {
                            const place = autoEnd.getPlace();
                            if (place.geometry && place.geometry.location) {
                                const lat = place.geometry.location.lat();
                                const lng = place.geometry.location.lng();
                                endLatInput.value = lat.toFixed(6);
                                endLngInput.value = lng.toFixed(6);
                                updateGoogleRoute();
                            }
                        });
                    }

                    // Click on Google Map
                    let clickToggle = false;
                    googleMap.addListener('click', function(e) {
                        const lat = e.latLng.lat();
                        const lng = e.latLng.lng();
                        const geocoder = new google.maps.Geocoder();

                        if (!clickToggle) {
                            startLatInput.value = lat.toFixed(6);
                            startLngInput.value = lng.toFixed(6);
                            geocoder.geocode({ location: { lat, lng } }, (res, status) => {
                                if (status === 'OK' && res[0] && startLocInput) {
                                    startLocInput.value = res[0].formatted_address.split(',').slice(0, 3).join(',');
                                }
                            });
                            clickToggle = true;
                        } else {
                            endLatInput.value = lat.toFixed(6);
                            endLngInput.value = lng.toFixed(6);
                            geocoder.geocode({ location: { lat, lng } }, (res, status) => {
                                if (status === 'OK' && res[0] && endLocInput) {
                                    endLocInput.value = res[0].formatted_address.split(',').slice(0, 3).join(',');
                                }
                            });
                            clickToggle = false;
                        }
                        updateGoogleRoute();
                    });

                    updateGoogleRoute();
                } catch(e) {
                    console.error('[Tagalong] Google Maps init error:', e);
                    initLeafletFallback();
                }
            }

            function updateGoogleRoute() {
                if (!googleMap || !googleDirectionsService) return;

                const pLat = parseFloat(startLatInput?.value) || 22.3667;
                const pLng = parseFloat(startLngInput?.value) || 70.7972;
                const dLat = parseFloat(endLatInput?.value) || 22.3168;
                const dLng = parseFloat(endLngInput?.value) || 70.7813;

                const origin = { lat: pLat, lng: pLng };
                const destination = { lat: dLat, lng: dLng };

                // Place custom Google markers
                if (!googlePickupMarker) {
                    googlePickupMarker = new google.maps.Marker({
                        position: origin,
                        map: googleMap,
                        title: 'Pickup (Departure)',
                        icon: {
                            path: google.maps.SymbolPath.CIRCLE,
                            scale: 8,
                            fillColor: '#16a34a',
                            fillOpacity: 1,
                            strokeColor: '#ffffff',
                            strokeWeight: 2
                        }
                    });
                } else {
                    googlePickupMarker.setPosition(origin);
                }

                if (!googleDropMarker) {
                    googleDropMarker = new google.maps.Marker({
                        position: destination,
                        map: googleMap,
                        title: 'Destination',
                        icon: {
                            path: google.maps.SymbolPath.CIRCLE,
                            scale: 8,
                            fillColor: '#eab308',
                            fillOpacity: 1,
                            strokeColor: '#ffffff',
                            strokeWeight: 2
                        }
                    });
                } else {
                    googleDropMarker.setPosition(destination);
                }

                googleDirectionsService.route({
                    origin: origin,
                    destination: destination,
                    travelMode: google.maps.TravelMode.DRIVING
                }, function(result, status) {
                    if (status === 'OK') {
                        googleDirectionsRenderer.setDirections(result);
                        const leg = result.routes[0].legs[0];
                        if (routeDistChip) routeDistChip.textContent = leg.distance.text;
                        if (routeDurChip) routeDurChip.textContent = `~${leg.duration.text}`;
                    } else {
                        // Fallback straight calculation
                        const distKm = haversineDistance([pLat, pLng], [dLat, dLng]) * 1.3;
                        const estMin = Math.round(distKm * 2.2 + 4);
                        if (routeDistChip) routeDistChip.textContent = `${distKm.toFixed(1)} km`;
                        if (routeDurChip) routeDurChip.textContent = `~${estMin} mins`;
                    }
                });
            }

            // Bulletproof Leaflet Fallback Engine (when Google key is absent or restricted)
            function initLeafletFallback() {
                if (leafletMap) return;
                const mapEl = document.getElementById('offerMap');
                if (!mapEl) return;

                if (mapEngineName) mapEngineName.textContent = 'Live GPS Active';

                let pickupCoord = [parseFloat(startLatInput?.value) || 22.3667, parseFloat(startLngInput?.value) || 70.7972];
                let dropoffCoord = [parseFloat(endLatInput?.value) || 22.3168, parseFloat(endLngInput?.value) || 70.7813];

                leafletMap = L.map('offerMap', {
                    center: [22.34, 70.79],
                    zoom: 12,
                    scrollWheelZoom: false
                });

                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
                    maxZoom: 19
                }).addTo(leafletMap);

                const pickupIcon = L.divIcon({
                    className: '',
                    html: '<div class="custom-map-pin pickup"><span class="pulse-ring"></span>🟢</div>',
                    iconSize: [32, 32],
                    iconAnchor: [16, 16]
                });

                const dropoffIcon = L.divIcon({
                    className: '',
                    html: '<div class="custom-map-pin dropoff"><span class="pulse-ring"></span>🏁</div>',
                    iconSize: [32, 32],
                    iconAnchor: [16, 16]
                });

                let pickupMarker = L.marker(pickupCoord, { icon: pickupIcon, draggable: true }).addTo(leafletMap);
                let dropMarker = L.marker(dropoffCoord, { icon: dropoffIcon, draggable: true }).addTo(leafletMap);
                let routePolyline = null;

                function updateLeafletRoute() {
                    const p1 = pickupMarker.getLatLng();
                    const p2 = dropMarker.getLatLng();

                    if (routePolyline) leafletMap.removeLayer(routePolyline);

                    routePolyline = L.polyline([p1, p2], {
                        color: '#facc15',
                        weight: 5,
                        opacity: 0.85,
                        dashArray: '8, 8',
                        lineJoin: 'round'
                    }).addTo(leafletMap);

                    leafletMap.fitBounds(L.latLngBounds([p1, p2]), { padding: [50, 50], maxZoom: 15 });

                    const distKm = haversineDistance([p1.lat, p1.lng], [p2.lat, p2.lng]) * 1.3;
                    const estMin = Math.round(distKm * 2.2 + 4);

                    if (routeDistChip) routeDistChip.textContent = `${distKm.toFixed(1)} km`;
                    if (routeDurChip) routeDurChip.textContent = `~${estMin} mins`;
                }

                pickupMarker.on('dragend', function(e) {
                    const pos = e.target.getLatLng();
                    startLatInput.value = pos.lat.toFixed(6);
                    startLngInput.value = pos.lng.toFixed(6);
                    reverseGeocode(pos.lat, pos.lng, startLocInput);
                    updateLeafletRoute();
                });

                dropMarker.on('dragend', function(e) {
                    const pos = e.target.getLatLng();
                    endLatInput.value = pos.lat.toFixed(6);
                    endLngInput.value = pos.lng.toFixed(6);
                    reverseGeocode(pos.lat, pos.lng, endLocInput);
                    updateLeafletRoute();
                });

                let nextClickIsPickup = false;
                leafletMap.on('click', function(e) {
                    if (nextClickIsPickup) {
                        pickupMarker.setLatLng(e.latlng);
                        startLatInput.value = e.latlng.lat.toFixed(6);
                        startLngInput.value = e.latlng.lng.toFixed(6);
                        reverseGeocode(e.latlng.lat, e.latlng.lng, startLocInput);
                        nextClickIsPickup = false;
                    } else {
                        dropMarker.setLatLng(e.latlng);
                        endLatInput.value = e.latlng.lat.toFixed(6);
                        endLngInput.value = e.latlng.lng.toFixed(6);
                        reverseGeocode(e.latlng.lat, e.latlng.lng, endLocInput);
                        nextClickIsPickup = true;
                    }
                    updateLeafletRoute();
                });

                updateLeafletRoute();
            }

            function reverseGeocode(lat, lng, targetInput) {
                fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data && data.display_name && targetInput) {
                            const parts = data.display_name.split(',');
                            targetInput.value = parts.slice(0, 3).join(',').trim();
                        }
                    })
                    .catch(() => {});
            }

            // Quick chip buttons
            document.querySelectorAll('.quick-chip').forEach(btn => {
                btn.addEventListener('click', function() {
                    const name = this.dataset.name;
                    const lat = parseFloat(this.dataset.lat);
                    const lng = parseFloat(this.dataset.lng);

                    if (!startLocInput.value || startLocInput.value.trim() === '') {
                        startLocInput.value = name;
                        startLatInput.value = lat;
                        startLngInput.value = lng;
                    } else {
                        endLocInput.value = name;
                        endLatInput.value = lat;
                        endLngInput.value = lng;
                    }

                    if (googleMap) {
                        updateGoogleRoute();
                    } else if (leafletMap) {
                        location.reload();
                    }
                });
            });

            // Start Map
            tryLoadGoogleMaps(gmapKey);

            // 4. QUICK ADD VEHICLE MODAL (AJAX)
            const btnSaveVehicle = document.getElementById('btnSaveVehicleModal');
            const modalAlert = document.getElementById('modalAlert');

            if (btnSaveVehicle) {
                btnSaveVehicle.addEventListener('click', function() {
                    const vType = document.getElementById('modalVehicleType').value;
                    const vModel = document.getElementById('modalModel').value.trim();
                    const vReg = document.getElementById('modalRegNumber').value.trim();
                    const vSeats = parseInt(document.getElementById('modalSeatCapacity').value, 10);

                    if (!vModel || !vReg || isNaN(vSeats) || vSeats < 1) {
                        modalAlert.textContent = 'Please fill out all fields with valid information.';
                        modalAlert.classList.remove('d-none');
                        return;
                    }

                    modalAlert.classList.add('d-none');
                    btnSaveVehicle.disabled = true;
                    btnSaveVehicle.querySelector('.btn-text').classList.add('d-none');
                    btnSaveVehicle.querySelector('.btn-loader').classList.remove('d-none');

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const csrfToken = tokenInput ? tokenInput.value : '';

                    fetch('/Profile/AddVehicleAjax', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken
                        },
                        body: JSON.stringify({
                            VehicleType: vType,
                            Model: vModel,
                            RegistrationNumber: vReg,
                            SeatCapacity: vSeats
                        })
                    })
                    .then(r => r.json())
                    .then(res => {
                        btnSaveVehicle.disabled = false;
                        btnSaveVehicle.querySelector('.btn-text').classList.remove('d-none');
                        btnSaveVehicle.querySelector('.btn-loader').classList.add('d-none');

                        if (res.success && res.vehicle) {
                            const v = res.vehicle;
                            const emptyBox = document.getElementById('emptyVehicleBox');
                            if (emptyBox) emptyBox.style.display = 'none';

                            let vehicleList = document.getElementById('vehicleList');
                            if (!vehicleList) {
                                vehicleList = document.createElement('div');
                                vehicleList.className = 'vehicle-selection-options';
                                vehicleList.id = 'vehicleList';
                                vehicleList.setAttribute('role', 'radiogroup');
                                document.getElementById('vehicleContainer').appendChild(vehicleList);
                            }

                            document.querySelectorAll('.vehicle-selection-input').forEach(i => i.checked = false);

                            const newOption = document.createElement('label');
                            newOption.className = 'vehicle-selection-option';
                            newOption.id = `vehicle-card-${v.vehicleId}`;
                            newOption.innerHTML = `
                                <input type="radio" class="vehicle-selection-input" name="VehicleId" value="${v.vehicleId}" checked required />
                                <div class="vehicle-selection-card">
                                    <div class="vehicle-selection-icon" aria-hidden="true">
                                        <i data-lucide="${v.vehicleType.toLowerCase() === 'motorcycle' ? 'bike' : 'car'}" style="width:26px;height:26px;"></i>
                                    </div>
                                    <div class="vehicle-selection-info flex-grow-1">
                                        <div class="vehicle-selection-model">${v.model} (${v.vehicleType})</div>
                                        <div class="vehicle-selection-details text-muted small d-flex align-items-center gap-2 mt-1">
                                            <span><i data-lucide="tag" style="width:13px;height:13px;"></i> ${v.registrationNumber}</span>
                                            <span><i data-lucide="users" style="width:13px;height:13px;"></i> ${v.seatCapacity} seats</span>
                                        </div>
                                    </div>
                                    <i data-lucide="check-circle" class="vehicle-selection-check text-gold" style="width:22px;height:22px;"></i>
                                </div>
                            `;
                            vehicleList.appendChild(newOption);

                            if (seatsInput) {
                                seatsInput.max = Math.max(1, v.seatCapacity - 1);
                                if (parseInt(seatsInput.value, 10) > seatsInput.max) {
                                    seatsInput.value = seatsInput.max;
                                    updateEarnings();
                                }
                            }

                            if (typeof lucide !== 'undefined') lucide.createIcons();

                            const modalEl = document.getElementById('quickAddVehicleModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                        } else {
                            modalAlert.textContent = res.message || 'Failed to save vehicle.';
                            modalAlert.classList.remove('d-none');
                        }
                    })
                    .catch(err => {
                        btnSaveVehicle.disabled = false;
                        btnSaveVehicle.querySelector('.btn-text').classList.remove('d-none');
                        btnSaveVehicle.querySelector('.btn-loader').classList.add('d-none');
                        modalAlert.textContent = 'Network or server error while saving vehicle.';
                        modalAlert.classList.remove('d-none');
                    });
                });
            }

            // Form submission loading state
            const form = document.getElementById('offerRideForm');
            const submitBtn = document.querySelector('.auth-submit');
            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    if (form.checkValidity()) {
                        submitBtn.disabled = true;
                        submitBtn.querySelector('.btn-text').classList.add('d-none');
                        submitBtn.querySelector('.btn-loader').classList.remove('d-none');
                    }
                });
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}
