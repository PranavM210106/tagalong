@{
    ViewData["Title"] = "Become a Driver";
}

@section Styles {
    <style>
        .page-header {
            padding: var(--space-12) 0 var(--space-8);
            border-bottom: 1px solid var(--color-border-default);
            margin-bottom: var(--space-8);
        }
        .breadcrumb {
            background: transparent;
            padding: 0;
        }
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: var(--color-text-disabled);
        }
        .breadcrumb-item a {
            text-decoration: none;
            transition: color var(--transition-fast);
        }
        .breadcrumb-item a:hover {
            color: var(--color-brand-primary);
        }
        .become-driver-page {
            padding: var(--space-8) 0 var(--space-16);
        }
        .content-card {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-2xl);
            padding: var(--space-8);
        }
        .hero-section {
            text-align: center;
            padding: var(--space-8) var(--space-4);
        }
        .hero-icon {
            width: 96px;
            height: 96px;
            border-radius: var(--radius-2xl);
            background: var(--gradient-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: var(--space-6);
        }
        .hero-icon i {
            width: 48px;
            height: 48px;
            color: var(--color-text-inverse);
        }
        .hero-title {
            font-size: var(--font-size-4xl);
            font-weight: var(--font-weight-bold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-4);
        }
        .hero-subtitle {
            font-size: var(--font-size-lg);
            color: var(--color-text-muted);
            max-width: 600px;
            margin: 0 auto var(--space-8);
        }
        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-6);
            margin-top: var(--space-8);
        }
        .benefit-card {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-xl);
            padding: var(--space-6);
            transition: all var(--transition-base);
        }
        .benefit-card:hover {
            border-color: var(--color-brand-primary);
            transform: translateY(-4px);
            box-shadow: var(--shadow-xl);
        }
        .benefit-icon {
            width: 56px;
            height: 56px;
            border-radius: var(--radius-lg);
            background: var(--color-brand-primary-light);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: var(--space-4);
        }
        .benefit-icon i {
            width: 28px;
            height: 28px;
            color: var(--color-brand-primary);
        }
        .benefit-title {
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-2);
        }
        .benefit-description {
            color: var(--color-text-muted);
            font-size: var(--font-size-base);
            line-height: 1.6;
        }
        .process-steps {
            margin-top: var(--space-10);
        }
        .process-title {
            text-align: center;
            font-size: var(--font-size-2xl);
            font-weight: var(--font-weight-bold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-8);
        }
        .steps-container {
            display: flex;
            flex-direction: column;
            gap: var(--space-6);
            max-width: 600px;
            margin: 0 auto;
        }
        .step-card {
            display: flex;
            gap: var(--space-5);
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-xl);
            padding: var(--space-5);
            transition: all var(--transition-base);
        }
        .step-card:hover {
            border-color: var(--color-brand-primary);
        }
        .step-number {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-lg);
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .step-number span {
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-bold);
            color: var(--color-text-inverse);
        }
        .step-content {
            flex: 1;
        }
        .step-title {
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-1);
        }
        .step-description {
            color: var(--color-text-muted);
            line-height: 1.6;
        }
        .cta-section {
            text-align: center;
            margin-top: var(--space-10);
            padding-top: var(--space-8);
            border-top: 1px solid var(--color-border-default);
        }
        .btn-primary-lg {
            padding: var(--space-4) var(--space-8);
            font-size: var(--font-size-lg);
            border-radius: var(--radius-lg);
        }
        .requirements-section {
            margin-top: var(--space-10);
        }
        .requirements-title {
            text-align: center;
            font-size: var(--font-size-xl);
            font-weight: var(--font-weight-bold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-6);
        }
        .requirements-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: var(--space-4);
        }
        .requirement-item {
            display: flex;
            align-items: flex-start;
            gap: var(--space-3);
            padding: var(--space-4);
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-lg);
        }
        .requirement-icon {
            width: 24px;
            height: 24px;
            color: var(--color-success);
            flex-shrink: 0;
            margin-top: 2px;
        }
        .requirement-text {
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
        }

        @@media (max-width: 767px) {
            .hero-title {
                font-size: var(--font-size-3xl);
            }
            .step-card {
                flex-direction: column;
                align-items: flex-start;
            }
            .step-number {
                align-self: flex-start;
            }
        }
    </style>
}

<!-- Page Header -->
<header class="page-header">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="breadcrumb mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-muted">
                        <i data-lucide="home" class="me-1" style="width:16px;height:16px;"></i>Home
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Rides" asp-action="Find" class="text-muted">Rides</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Become a Driver</li>
            </ol>
        </nav>
        <h1 class="h2 mb-0 fw-semibold">Become a Driver</h1>
        <p class="text-muted mt-1">Start earning by offering rides on Tagalong</p>
    </div>
</header>

<!-- Become Driver Page -->
<main class="become-driver-page">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="content-card">
                    <!-- Hero Section -->
                    <div class="hero-section">
                        <div class="hero-icon" aria-hidden="true">
                            <i data-lucide="truck"></i>
                        </div>
                        <h2 class="hero-title">Start Driving with Tagalong</h2>
                        <p class="hero-subtitle">Turn your daily commute or spare time into earnings. Join thousands of drivers earning on their own schedule.</p>
                    </div>

                    <!-- Benefits -->
                    <div class="benefits-grid" role="list" aria-label="Driver benefits">
                        <article class="benefit-card" role="listitem">
                            <div class="benefit-icon" aria-hidden="true">
                                <i data-lucide="clock"></i>
                            </div>
                            <h3 class="benefit-title">Flexible Schedule</h3>
                            <p class="benefit-description">Drive whenever you want — mornings, evenings, weekends. You're in complete control of your hours.</p>
                        </article>
                        <article class="benefit-card" role="listitem">
                            <div class="benefit-icon" aria-hidden="true">
                                <i data-lucide="dollar-sign"></i>
                            </div>
                            <h3 class="benefit-title">Competitive Earnings</h3>
                            <p class="benefit-description">Set your own prices per seat. Keep 85% of each fare — one of the best rates in the industry.</p>
                        </article>
                        <article class="benefit-card" role="listitem">
                            <div class="benefit-icon" aria-hidden="true">
                                <i data-lucide="map-pin"></i>
                            </div>
                            <h3 class="benefit-title">Drive Your Route</h3>
                            <p class="benefit-description">Offer rides on routes you already drive. No detours — just pick up passengers along your way.</p>
                        </article>
                        <article class="benefit-card" role="listitem">
                            <div class="benefit-icon" aria-hidden="true">
                                <i data-lucide="shield"></i>
                            </div>
                            <h3 class="benefit-title">Safety First</h3>
                            <p class="benefit-description">Verified riders, in-app chat, real-time tracking, and 24/7 support. Your safety is our priority.</p>
                        </article>
                        <article class="benefit-card" role="listitem">
                            <div class="benefit-icon" aria-hidden="true">
                                <i data-lucide="star"></i>
                            </div>
                            <h3 class="benefit-title">Build Reputation</h3>
                            <p class="benefit-description">Earn ratings and reviews. Top-rated drivers get priority visibility and bonus incentives.</p>
                        </article>
                        <article class="benefit-card" role="listitem">
                            <div class="benefit-icon" aria-hidden="true">
                                <i data-lucide="zap"></i>
                            </div>
                            <h3 class="benefit-title">Instant Payouts</h3>
                            <p class="benefit-description">Get paid after every completed ride. No waiting periods — your earnings, your schedule.</p>
                        </article>
                    </div>

                    <!-- Process Steps -->
                    <div class="process-steps">
                        <h3 class="process-title">How to Get Started</h3>
                        <div class="steps-container">
                            <div class="step-card">
                                <div class="step-number" aria-hidden="true"><span>1</span></div>
                                <div class="step-content">
                                    <h4 class="step-title">Register as a Driver</h4>
                                    <p class="step-description">Switch to driver mode in your profile. Upload your license, vehicle registration, and insurance documents.</p>
                                </div>
                            </div>
                            <div class="step-card">
                                <div class="step-number" aria-hidden="true"><span>2</span></div>
                                <div class="step-content">
                                    <h4 class="step-title">Vehicle Verification</h4>
                                    <p class="step-description">Our team reviews your documents within 24 hours. Once approved, your vehicle is ready for rides.</p>
                                </div>
                            </div>
                            <div class="step-card">
                                <div class="step-number" aria-hidden="true"><span>3</span></div>
                                <div class="step-content">
                                    <h4 class="step-title">Offer Your First Ride</h4>
                                    <p class="step-description">Create a ride listing with your route, schedule, and price. Riders will see and book your ride.</p>
                                </div>
                            </div>
                            <div class="step-card">
                                <div class="step-number" aria-hidden="true"><span>4</span></div>
                                <div class="step-content">
                                    <h4 class="step-title">Start Earning</h4>
                                    <p class="step-description">Pick up passengers, complete rides, and get paid instantly. Track your earnings in real-time.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Requirements -->
                    <div class="requirements-section">
                        <h3 class="requirements-title">Requirements</h3>
                        <div class="requirements-list">
                            <div class="requirement-item">
                                <i data-lucide="check-circle" class="requirement-icon" aria-hidden="true"></i>
                                <span class="requirement-text">Valid driver's license (minimum 1 year experience)</span>
                            </div>
                            <div class="requirement-item">
                                <i data-lucide="check-circle" class="requirement-icon" aria-hidden="true"></i>
                                <span class="requirement-text">Vehicle registration and insurance in your name</span>
                            </div>
                            <div class="requirement-item">
                                <i data-lucide="check-circle" class="requirement-icon" aria-hidden="true"></i>
                                <span class="requirement-text">Vehicle model year 2015 or newer</span>
                            </div>
                            <div class="requirement-item">
                                <i data-lucide="check-circle" class="requirement-icon" aria-hidden="true"></i>
                                <span class="requirement-text">Clean driving record</span>
                            </div>
                            <div class="requirement-item">
                                <i data-lucide="check-circle" class="requirement-icon" aria-hidden="true"></i>
                                <span class="requirement-text">Smartphone with Tagalong app installed</span>
                            </div>
                            <div class="requirement-item">
                                <i data-lucide="check-circle" class="requirement-icon" aria-hidden="true"></i>
                                <span class="requirement-text">Background check clearance</span>
                            </div>
                        </div>
                    </div>

                    <!-- CTA -->
                    <div class="cta-section">
                        <p class="text-muted mb-4">Ready to start earning? Switch to driver mode and begin your verification.</p>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Driver" class="btn btn-primary btn-primary-lg">
                            <i data-lucide="plus-circle" class="me-2" aria-hidden="true"></i>Register as Driver
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Lucide icons
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}