@model IEnumerable<Tagalong.Models.ViewModels.RideResultViewModel>
@{
    ViewData["Title"] = "Matching Rides - Tagalong";
    var rideList = Model?.ToList() ?? new List<Tagalong.Models.ViewModels.RideResultViewModel>();
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Rides" asp-action="Find" class="text-muted">Rides</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Search Results</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 id="page-title" class="display-5 fw-bold mb-1">Available Rides</h1>
                <p class="lead text-muted mb-0">Found <strong class="text-white">@rideList.Count</strong> matching @(rideList.Count == 1 ? "ride" : "rides") along your route</p>
            </div>
            <div>
                <a asp-action="Find" class="btn btn-outline-light btn-sm">
                    <i data-lucide="sliders-horizontal" class="me-1"></i> Modify Search
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Booking Confirmation Modal (Uber & Rapido Grade) -->
<div class="modal fade" id="bookingConfirmModal" tabindex="-1" aria-labelledby="bookingConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #11131a; border: 1px solid rgba(255,255,255,0.12); border-radius: 20px;">
            <div class="modal-header border-bottom border-white-10 p-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold">₹ COMMUTE SHARE</span>
                    <h5 class="modal-title text-white fw-bold mb-0" id="bookingConfirmTitle">Confirm Your Ride</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Rides" asp-action="RequestToJoin" method="post" id="modalBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rideId" id="modalRideId" />
                <div class="modal-body p-4">
                    <!-- Route -->
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
                        <div class="text-xs text-muted text-uppercase fw-semibold mb-1">Route Corridor</div>
                        <div class="text-white fw-bold fs-6" id="modalRoute">—</div>
                        <div class="text-muted small mt-1" id="modalTime">—</div>
                    </div>

                    <!-- Driver & Vehicle -->
                    <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                        <div>
                            <div class="text-xs text-muted text-uppercase fw-semibold">Driver</div>
                            <div class="text-white fw-medium" id="modalDriver">—</div>
                        </div>
                        <div class="text-end">
                            <div class="text-xs text-muted text-uppercase fw-semibold">Vehicle</div>
                            <div class="text-white small" id="modalVehicle">—</div>
                        </div>
                    </div>

                    <!-- Seats Selector -->
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: rgba(234, 179, 8, 0.08); border: 1px solid rgba(234, 179, 8, 0.25);">
                        <div>
                            <div class="fw-bold text-white">Seats to Reserve</div>
                            <div class="text-muted small"><span id="modalMaxSeats">0</span> seats available</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-warning" id="btnMinusSeat" style="width:32px;height:32px;border-radius:50%;">-</button>
                            <input type="number" name="seatsBooked" id="modalSeatsCount" value="1" min="1" max="4" readonly style="width:40px; text-align:center; background:transparent; border:none; color:#fff; font-weight:bold; font-size:1.1rem;" />
                            <button type="button" class="btn btn-sm btn-outline-warning" id="btnPlusSeat" style="width:32px;height:32px;border-radius:50%;">+</button>
                        </div>
                    </div>

                    <!-- Price Calculation -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white-10">
                        <span class="text-muted">Total Fare in ₹:</span>
                        <div class="text-gold fw-bold fs-4" id="modalTotalFare">₹0</div>
                    </div>
                </div>
                <div class="modal-footer border-top border-white-10 p-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        Confirm & Request Ride
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<section class="results-page">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row g-4">
            <!-- Sidebar Filters -->
            <aside class="col-12 col-lg-4 col-xl-3 results-sidebar">
                <div class="sidebar-card">
                    <div class="sidebar-header d-flex justify-content-between align-items-center">
                        <h2 class="h6 fw-bold mb-0 text-uppercase tracking-wider">Filters</h2>
                        <button type="button" class="btn btn-xs btn-ghost text-gold" id="clearFilters">Reset All</button>
                    </div>
                    <div class="sidebar-body">
                        <!-- Max Price Filter -->
                        <div class="filter-group">
                            <label class="filter-title">Price Range (₹)</label>
                            <div class="row g-2 price-range-inputs">
                                <div class="col-6">
                                    <input type="number" class="form-control" id="priceMin" placeholder="Min" min="0" />
                                </div>
                                <div class="col-6">
                                    <input type="number" class="form-control" id="priceMax" placeholder="Max" min="0" />
                                </div>
                            </div>
                        </div>

                        <!-- Seats Filter -->
                        <div class="filter-group">
                            <label class="filter-title">Seats Needed</label>
                            <div class="seats-filter" role="radiogroup">
                                @for (int s = 1; s <= 4; s++)
                                {
                                    <label class="seat-option">
                                        <input type="radio" name="seatsFilter" class="seat-input" value="@s" @(s == 1 ? "checked" : "") />
                                        <span class="seat-label">@s+</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Match Quality Filter -->
                        <div class="filter-group">
                            <label class="filter-title">Proximity Match</label>
                            <div class="quality-filter">
                                <label class="quality-option">
                                    <input type="checkbox" class="quality-input" value="Excellent Match" checked />
                                    <span class="quality-label">
                                        <span class="quality-badge excellent">High</span>
                                        <span class="quality-desc">Direct route (&lt; 2km)</span>
                                    </span>
                                </label>
                                <label class="quality-option">
                                    <input type="checkbox" class="quality-input" value="Good Match" checked />
                                    <span class="quality-label">
                                        <span class="quality-badge good">Good</span>
                                        <span class="quality-desc">Minor detour (&lt; 5km)</span>
                                    </span>
                                </label>
                                <label class="quality-option">
                                    <input type="checkbox" class="quality-input" value="Fair Match" checked />
                                    <span class="quality-label">
                                        <span class="quality-badge fair">Fair</span>
                                        <span class="quality-desc">Within 10km radius</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Results Main Content -->
            <main class="col-12 col-lg-8 col-xl-9">
                <!-- Toolbar -->
                <div class="results-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-xs text-muted text-uppercase fw-semibold">Sort By:</span>
                        <div class="results-sort">
                            <select id="sortBy" class="form-select form-select-sm" aria-label="Sort matching rides">
                                <option value="match" selected>Best Route Match</option>
                                <option value="price-asc">Price: Low to High</option>
                                <option value="price-desc">Price: High to Low</option>
                                <option value="time-asc">Earliest Departure</option>
                                <option value="rating">Top Rated Drivers</option>
                            </select>
                        </div>
                    </div>
                    <div class="results-view-toggle d-none d-sm-flex gap-1" role="group" aria-label="Layout view">
                        <button type="button" class="btn btn-sm btn-secondary active" data-view="grid" aria-label="Grid layout" aria-pressed="true">
                            <i data-lucide="grid" style="width: 16px; height: 16px;"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary" data-view="list" aria-label="List layout" aria-pressed="false">
                            <i data-lucide="list" style="width: 16px; height: 16px;"></i>
                        </button>
                    </div>
                </div>

                @if (rideList.Any())
                {
                    <!-- Grid View Container -->
                    <div class="ride-results-grid" role="list">
                        @foreach (var item in rideList)
                        {
                            var ride = item.Ride;
                            var matchQuality = item.MatchQuality ?? "Good Match";
                            var rating = ride.Driver?.AverageRating ?? 4.8;
                            var qualityClass = matchQuality.Replace(" ", "-").ToLower();

                            <div class="ride-result-item" role="listitem"
                                 data-price="@ride.PricePerSeat"
                                 data-seats="@ride.SeatsAvailable"
                                 data-departure="@ride.DepartureTime.Ticks"
                                 data-rating="@rating"
                                 data-match-quality="@matchQuality">
                                <article class="ride-card h-100">
                                    <div class="ride-card-header d-flex justify-content-between align-items-center">
                                        <span class="match-quality-badge @(qualityClass)">
                                            @matchQuality
                                        </span>
                                        <div class="text-gold fw-bold fs-5">
                                            ₹@ride.PricePerSeat <span class="text-xs text-muted">/ seat</span>
                                        </div>
                                    </div>

                                    <div class="ride-card-body">
                                        <!-- Route Timeline -->
                                        <div class="route-badge mb-3 w-100">
                                            <i data-lucide="map-pin" class="me-1"></i>
                                            <span class="text-truncate">@ride.StartLocation → @ride.EndLocation</span>
                                        </div>

                                        <div class="ride-meta">
                                            <div class="meta-item">
                                                <i data-lucide="clock" class="meta-icon"></i>
                                                <span>@ride.DepartureTime.ToString("ddd, MMM dd • h:mm tt")</span>
                                            </div>
                                            <div class="meta-item">
                                                <i data-lucide="users" class="meta-icon"></i>
                                                <span class="@(ride.SeatsAvailable <= 1 ? "text-warning fw-semibold" : "")">
                                                    @ride.SeatsAvailable @(ride.SeatsAvailable == 1 ? "seat" : "seats") left
                                                </span>
                                            </div>
                                            @if (ride.Vehicle != null)
                                            {
                                                <div class="meta-item">
                                                    <i data-lucide="car" class="meta-icon"></i>
                                                    <span>@ride.Vehicle.Model (@ride.Vehicle.RegistrationNumber)</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Driver info -->
                                        <div class="driver-info d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="driver-avatar">
                                                    @if (!string.IsNullOrEmpty(ride.Driver?.ProfilePicture))
                                                    {
                                                        <img src="@ride.Driver.ProfilePicture" alt="@ride.Driver.FullName" />
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-placeholder d-flex align-items-center justify-content-center">
                                                            <i data-lucide="user" class="avatar-icon text-muted"></i>
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="driver-name text-sm">@(ride.Driver?.FullName ?? "Verified Driver")</div>
                                                    <div class="driver-rating d-flex align-items-center gap-1 text-xs">
                                                        <i data-lucide="star" class="fill text-gold" style="width: 12px; height: 12px;"></i>
                                                        <span class="text-muted">@rating.ToString("0.0")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="ride-card-footer">
                                        <button type="button" class="btn btn-primary w-100 btn-book-trigger"
                                                data-ride-id="@ride.RideId"
                                                data-route="@ride.StartLocation → @ride.EndLocation"
                                                data-driver="@(ride.Driver?.FullName ?? "Driver")"
                                                data-price="@ride.PricePerSeat"
                                                data-seats="@ride.SeatsAvailable"
                                                data-time="@ride.DepartureTime.ToString("MMM dd, hh:mm tt")"
                                                data-vehicle="@(ride.Vehicle != null ? $"{ride.Vehicle.Model} ({ride.Vehicle.RegistrationNumber})" : "Standard Commute")">
                                            <i data-lucide="check-circle" class="me-1"></i> Request to Join
                                        </button>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>

                    <!-- List View Container (Initially Hidden) -->
                    <div class="ride-results-list d-none" role="list">
                        @foreach (var item in rideList)
                        {
                            var ride = item.Ride;
                            var matchQuality = item.MatchQuality ?? "Good Match";
                            var rating = ride.Driver?.AverageRating ?? 4.8;
                            var qualityClass = matchQuality.Replace(" ", "-").ToLower();

                            <div class="ride-result-item" role="listitem"
                                 data-price="@ride.PricePerSeat"
                                 data-seats="@ride.SeatsAvailable"
                                 data-departure="@ride.DepartureTime.Ticks"
                                 data-rating="@rating"
                                 data-match-quality="@matchQuality">
                                <article class="card card-elevated p-3 mb-3">
                                    <div class="row align-items-center g-3">
                                        <div class="col-12 col-md-5">
                                            <span class="match-quality-badge @(qualityClass) mb-2">@matchQuality</span>
                                            <div class="fw-bold text-white fs-6">@ride.StartLocation → @ride.EndLocation</div>
                                            <div class="text-muted text-xs mt-1">@ride.DepartureTime.ToString("MMM dd • h:mm tt")</div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="text-xs text-muted">Driver</div>
                                            <div class="text-sm fw-medium">@(ride.Driver?.FullName ?? "Driver")</div>
                                            <div class="text-xs text-gold">★ @rating.ToString("0.0")</div>
                                        </div>
                                        <div class="col-6 col-md-2 text-md-center">
                                            <div class="text-gold fw-bold fs-5">₹@ride.PricePerSeat</div>
                                            <div class="text-xs text-muted">@ride.SeatsAvailable left</div>
                                        </div>
                                        <div class="col-12 col-md-2">
                                            <form asp-action="RequestToJoin" asp-route-rideId="@ride.RideId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                                    Join
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state text-center py-5 p-4">
                        <div class="avatar avatar-2xl mx-auto mb-3 bg-secondary">
                            <i data-lucide="map-pin-off" style="width: 36px; height: 36px; color: var(--color-brand-primary);"></i>
                        </div>
                        <h3 class="h4 fw-bold mb-2">No Matching Rides Found</h3>
                        <p class="text-muted small mb-4 max-w-md mx-auto">
                            No drivers are currently offering rides matching this exact corridor and time.
                            Try expanding your search distance or offer a ride yourself.
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Find" class="btn btn-secondary">Change Locations</a>
                            <a asp-action="Offer" class="btn btn-primary">Offer This Ride Instead</a>
                        </div>
                    </div>
                }
            </main>
        </div>
    </div>
</section>

<!-- Mobile Filter Floating Action Button -->
<button type="button" class="btn btn-primary btn-lg rounded-full sidebar-toggle shadow-xl" aria-label="Open Filters">
    <i data-lucide="sliders" class="me-1"></i> Filter
</button>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/rides.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        // Booking Modal Interactivity
        let currentPricePerSeat = 0;
        let currentAvailableSeats = 1;

        function updateModalTotal() {
            const countInput = document.getElementById('modalSeatsCount');
            const totalEl = document.getElementById('modalTotalFare');
            const count = parseInt(countInput.value) || 1;
            totalEl.textContent = '₹' + (count * currentPricePerSeat);
        }

        document.querySelectorAll('.btn-book-trigger').forEach(btn => {
            btn.addEventListener('click', function() {
                const rideId = this.getAttribute('data-ride-id');
                const route = this.getAttribute('data-route');
                const driver = this.getAttribute('data-driver');
                const price = parseFloat(this.getAttribute('data-price')) || 0;
                const seats = parseInt(this.getAttribute('data-seats')) || 1;
                const time = this.getAttribute('data-time');
                const vehicle = this.getAttribute('data-vehicle');

                currentPricePerSeat = price;
                currentAvailableSeats = seats;

                document.getElementById('modalRideId').value = rideId;
                document.getElementById('modalRoute').textContent = route;
                document.getElementById('modalDriver').textContent = driver;
                document.getElementById('modalTime').textContent = time;
                document.getElementById('modalVehicle').textContent = vehicle;
                document.getElementById('modalMaxSeats').textContent = seats;
                document.getElementById('modalSeatsCount').value = 1;

                updateModalTotal();

                const modal = new bootstrap.Modal(document.getElementById('bookingConfirmModal'));
                modal.show();
            });
        });

        const btnMinus = document.getElementById('btnMinusSeat');
        const btnPlus = document.getElementById('btnPlusSeat');
        if (btnMinus) {
            btnMinus.addEventListener('click', function() {
                const countInput = document.getElementById('modalSeatsCount');
                let count = parseInt(countInput.value) || 1;
                if (count > 1) {
                    countInput.value = count - 1;
                    updateModalTotal();
                }
            });
        }
        if (btnPlus) {
            btnPlus.addEventListener('click', function() {
                const countInput = document.getElementById('modalSeatsCount');
                let count = parseInt(countInput.value) || 1;
                if (count < currentAvailableSeats) {
                    countInput.value = count + 1;
                    updateModalTotal();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const gridView = document.querySelector('.ride-results-grid');
            const listView = document.querySelector('.ride-results-list');
            const viewButtons = document.querySelectorAll('[data-view]');
            const sortSelect = document.getElementById('sortBy');
            const priceMin = document.getElementById('priceMin');
            const priceMax = document.getElementById('priceMax');
            const seatInputs = document.querySelectorAll('.seat-input');
            const qualityInputs = document.querySelectorAll('.quality-input');
            const clearFiltersBtn = document.getElementById('clearFilters');
            const rideItems = document.querySelectorAll('.ride-result-item');
            const sidebar = document.querySelector('.results-sidebar');
            const sidebarToggle = document.querySelector('.sidebar-toggle');

            // View toggle (Grid / List)
            viewButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const view = this.dataset.view;
                    viewButtons.forEach(b => {
                        b.classList.toggle('active', b.dataset.view === view);
                        b.setAttribute('aria-pressed', b.dataset.view === view);
                    });
                    if (gridView && listView) {
                        if (view === 'grid') {
                            gridView.classList.remove('d-none');
                            listView.classList.add('d-none');
                        } else {
                            gridView.classList.add('d-none');
                            listView.classList.remove('d-none');
                        }
                    }
                });
            });

            // Sorting
            function sortItems() {
                if (!sortSelect) return;
                const sortBy = sortSelect.value;
                const containers = [gridView, listView].filter(c => c);

                containers.forEach(container => {
                    const items = Array.from(container.querySelectorAll('.ride-result-item'));
                    items.sort((a, b) => {
                        switch (sortBy) {
                            case 'price-asc':
                                return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                            case 'price-desc':
                                return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                            case 'time-asc':
                                return parseInt(a.dataset.departure) - parseInt(b.dataset.departure);
                            case 'rating':
                                return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
                            case 'match':
                            default:
                                const matchOrder = { 'Excellent Match': 0, 'Good Match': 1, 'Fair Match': 2, 'Poor Match': 3 };
                                return (matchOrder[a.dataset.matchQuality] || 99) - (matchOrder[b.dataset.matchQuality] || 99);
                        }
                    });
                    items.forEach(item => container.appendChild(item));
                });
            }

            if (sortSelect) {
                sortSelect.addEventListener('change', sortItems);
            }

            // Filtering
            function applyFilters() {
                const minPrice = priceMin?.value ? parseFloat(priceMin.value) : 0;
                const maxPrice = priceMax?.value ? parseFloat(priceMax.value) : Infinity;
                const minSeats = parseInt(document.querySelector('.seat-input:checked')?.value || '1');
                const selectedQualities = Array.from(qualityInputs)
                    .filter(i => i.checked)
                    .map(i => i.value);

                rideItems.forEach(item => {
                    const price = parseFloat(item.dataset.price);
                    const seats = parseInt(item.dataset.seats);
                    const quality = item.dataset.matchQuality;

                    const priceMatch = price >= minPrice && price <= maxPrice;
                    const seatsMatch = seats >= minSeats;
                    const qualityMatch = selectedQualities.length === 0 || selectedQualities.includes(quality);

                    if (priceMatch && seatsMatch && qualityMatch) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            [priceMin, priceMax].forEach(input => {
                if (input) input.addEventListener('input', applyFilters);
            });
            seatInputs.forEach(input => {
                input.addEventListener('change', applyFilters);
            });
            qualityInputs.forEach(input => {
                input.addEventListener('change', applyFilters);
            });

            // Reset filters
            if (clearFiltersBtn) {
                clearFiltersBtn.addEventListener('click', function() {
                    if (priceMin) priceMin.value = '';
                    if (priceMax) priceMax.value = '';
                    if (seatInputs.length > 0) seatInputs[0].checked = true;
                    qualityInputs.forEach(input => input.checked = true);
                    applyFilters();
                });
            }

            // Mobile sidebar toggle
            if (sidebarToggle && sidebar) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('open');
                });
                sidebar.addEventListener('click', function(e) {
                    if (e.target === sidebar) {
                        sidebar.classList.remove('open');
                    }
                });
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}
