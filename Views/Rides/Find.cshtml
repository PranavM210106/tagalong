@model Tagalong.Models.ViewModels.FindRideViewModel
@{
    ViewData["Title"] = "Find a Ride";
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Rides" asp-action="Index" class="text-muted">Rides</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Find a Ride</li>
            </ol>
        </nav>
        <header>
            <h1 id="page-title" class="display-5 fw-bold mb-1">Find a Ride</h1>
            <p class="lead text-muted mb-0">Search for rides matching your route and schedule</p>
        </header>
    </div>
</section>

<section class="form-page">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-7">
                <form asp-action="Find" method="post" class="ride-form find-ride-form" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary mb-4" role="alert" aria-live="polite"></div>

                    <!-- Section 1: Route -->
                    <fieldset class="form-section mb-5">
                        <legend class="section-title">
                            <i data-lucide="map-pin" class="me-2" aria-hidden="true"></i>
                            Your Route
                        </legend>
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="PickupLocation" class="form-label">Pickup Location <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-wrapper">
                                        <input asp-for="PickupLocation" class="form-control" placeholder="Enter pickup address" autocomplete="address-line1" aria-describedby="pickupLocation-error" />
                                        <i data-lucide="map-pin" class="input-icon" aria-hidden="true"></i>
                                        <button type="button" class="location-btn" aria-label="Use current location for pickup">
                                            <i data-lucide="navigation" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="PickupLocation" class="form-error" id="pickupLocation-error"></span>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="DropLocation" class="form-label">Drop-off Location <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-wrapper">
                                        <input asp-for="DropLocation" class="form-control" placeholder="Enter drop-off address" autocomplete="address-line2" aria-describedby="dropLocation-error" />
                                        <i data-lucide="map-pin" class="input-icon" aria-hidden="true"></i>
                                        <button type="button" class="location-btn" aria-label="Use current location for drop-off">
                                            <i data-lucide="navigation" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="DropLocation" class="form-error" id="dropLocation-error"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Hidden lat/lng fields -->
                        <div class="row g-4 d-none">
                            <div class="col-12 col-md-6">
                                <input asp-for="PickupLat" type="hidden" />
                                <span asp-validation-for="PickupLat" class="form-error"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <input asp-for="PickupLng" type="hidden" />
                                <span asp-validation-for="PickupLng" class="form-error"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <input asp-for="DropLat" type="hidden" />
                                <span asp-validation-for="DropLat" class="form-error"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <input asp-for="DropLng" type="hidden" />
                                <span asp-validation-for="DropLng" class="form-error"></span>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Section 2: Date & Time -->
                    <fieldset class="form-section mb-5">
                        <legend class="section-title">
                            <i data-lucide="calendar" class="me-2" aria-hidden="true"></i>
                            When to Travel
                        </legend>
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label asp-for="PreferredTime" class="form-label">Preferred Date & Time <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-wrapper">
                                        <input asp-for="PreferredTime" class="form-control" type="datetime-local" aria-describedby="preferredTime-error" />
                                        <i data-lucide="clock" class="input-icon" aria-hidden="true"></i>
                                    </div>
                                    <span asp-validation-for="PreferredTime" class="form-error" id="preferredTime-error"></span>
                                    <div class="form-hint">We'll find rides departing within 2 hours of this time</div>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Search Filters -->
                    <fieldset class="form-section mb-5">
                        <legend class="section-title">
                            <i data-lucide="sliders-horizontal" class="me-2" aria-hidden="true"></i>
                            Filters (Optional)
                        </legend>
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Max Price per Seat ($)</label>
                                    <div class="input-wrapper">
                                        <span class="input-prefix">$</span>
                                        <input type="number" id="maxPrice" class="form-control" step="0.01" min="0" placeholder="Any price" />
                                        <i data-lucide="dollar-sign" class="input-icon" aria-hidden="true"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Minimum Seats Needed</label>
                                    <div class="input-wrapper">
                                        <select id="minSeats" class="form-control" aria-describedby="minSeats-hint">
                                            <option value="1" selected>1 seat</option>
                                            <option value="2">2 seats</option>
                                            <option value="3">3 seats</option>
                                            <option value="4">4 seats</option>
                                        </select>
                                        <i data-lucide="users" class="input-icon" aria-hidden="true"></i>
                                    </div>
                                    <div class="form-hint" id="minSeats-hint">Select how many seats you need</div>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Form Actions -->
                    <div class="form-actions sticky-bottom d-flex flex-column flex-md-row gap-3 justify-content-end">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg py-3 px-5 order-md-1 order-2">
                            <i data-lucide="x" class="me-2" aria-hidden="true"></i>
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg py-3 px-5 order-md-2 order-1 auth-submit" data-loading-text="Searching rides...">
                            <span class="btn-text">
                                <i data-lucide="search" class="me-2" aria-hidden="true"></i>
                                Find Rides
                            </span>
                            <span class="btn-loader d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Searching...
                            </span>
                        </button>
                    </div>
                </form>

                <!-- Quick Tips -->
                <div class="quick-tips mt-5 p-4 rounded-3" style="background: var(--color-brand-primary-light); border: 1px solid var(--color-brand-primary);">
                    <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
                        <i data-lucide="lightbulb" class="text-gold" aria-hidden="true"></i>
                        Search Tips
                    </h3>
                    <ul class="mb-0 text-sm text-muted">
                        <li class="mb-2">Use nearby landmarks or intersections for better matching</li>
                        <li class="mb-2">Broader time windows return more results</li>
                        <li class="mb-2">Check back later — new rides are added frequently</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .page-header {
            padding: var(--space-12) 0 var(--space-8);
            border-bottom: 1px solid var(--color-border-default);
            margin-bottom: var(--space-8);
        }
        .breadcrumb {
            background: transparent;
            padding: 0;
        }
        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: var(--color-text-disabled);
        }
        .breadcrumb-item a {
            text-decoration: none;
            transition: color var(--transition-fast);
        }
        .breadcrumb-item a:hover {
            color: var(--color-brand-primary);
        }
        .form-page {
            padding: var(--space-8) 0 var(--space-16);
        }
        .ride-form {
            background: var(--color-bg-card);
            border: 1px solid var(--color-border-default);
            border-radius: var(--radius-2xl);
            padding: var(--space-8);
        }
        .form-section {
            padding-bottom: var(--space-5);
            border-bottom: 1px solid var(--color-border-default);
        }
        .form-section:last-of-type {
            border-bottom: none;
            padding-bottom: 0;
        }
        .section-title {
            display: inline-flex;
            align-items: center;
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-primary);
            margin-bottom: var(--space-5);
            padding-bottom: var(--space-3);
            border-bottom: 2px solid var(--color-brand-primary);
        }
        .section-title i {
            width: 20px;
            height: 20px;
        }
        .form-label {
            display: block;
            font-size: var(--font-size-xs);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: var(--space-2);
        }
        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        .input-wrapper .form-control {
            padding-left: 3rem;
        }
        .input-wrapper .input-prefix {
            position: absolute;
            left: 1rem;
            color: var(--color-text-disabled);
            font-weight: var(--font-weight-medium);
            z-index: 2;
        }
        .input-wrapper .input-prefix + .form-control {
            padding-left: 2.5rem;
        }
        .input-icon {
            position: absolute;
            left: var(--space-4);
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            color: var(--color-text-disabled);
            pointer-events: none;
            transition: color var(--transition-fast);
            z-index: 2;
        }
        .input-wrapper:has(.input-prefix) .input-icon {
            left: calc(var(--space-4) + 1.25rem);
        }
        .form-control:focus + .input-icon,
        .form-control:focus ~ .input-icon {
            color: var(--color-brand-primary);
        }
        .location-btn {
            position: absolute;
            right: var(--space-4);
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: var(--space-2);
            color: var(--color-text-disabled);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-md);
            transition: all var(--transition-fast);
        }
        .location-btn:hover {
            background: var(--color-brand-primary-light);
            color: var(--color-brand-primary);
        }
        .location-btn i {
            width: 20px;
            height: 20px;
        }
        .form-control {
            background: var(--color-bg-tertiary);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            color: var(--color-text-primary);
            padding: var(--space-3) var(--space-4);
            font-size: var(--font-size-base);
            transition: all var(--transition-base);
            height: auto;
        }
        .form-control::placeholder {
            color: var(--color-text-disabled);
        }
        .form-control:focus {
            background: var(--color-bg-tertiary);
            border-color: var(--color-brand-primary);
            box-shadow: 0 0 0 3px var(--color-brand-primary-light);
            color: var(--color-text-primary);
        }
        .form-control.is-invalid,
        .form-control:invalid {
            border-color: var(--color-danger);
        }
        .form-control.is-invalid:focus,
        .form-control:invalid:focus {
            box-shadow: 0 0 0 3px var(--color-danger-light);
        }
        .form-error {
            display: block;
            color: var(--color-danger);
            font-size: var(--font-size-xs);
            margin-top: var(--space-1);
        }
        .validation-summary {
            background: var(--color-danger-light);
            border: 1px solid rgba(220, 38, 38, 0.3);
            border-radius: var(--radius-lg);
            padding: var(--space-4);
            color: var(--color-danger);
        }
        .form-hint {
            display: block;
            color: var(--color-text-disabled);
            font-size: var(--font-size-xs);
            margin-top: var(--space-1);
        }

        /* Form Actions */
        .form-actions {
            padding-top: var(--space-5);
            margin-top: var(--space-5);
            border-top: 1px solid var(--color-border-default);
        }
        .form-actions.sticky-bottom {
            position: sticky;
            bottom: 0;
            background: linear-gradient(to top, var(--color-bg-card), transparent);
            z-index: 10;
        }
        .auth-submit {
            border-radius: var(--radius-lg);
            background: var(--gradient-primary);
            border: none;
            transition: all var(--transition-base);
            min-width: 200px;
        }
        .auth-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: var(--shadow-glow);
        }
        .auth-submit:active:not(:disabled) {
            transform: translateY(0);
        }
        .auth-submit:disabled {
            opacity: 0.7;
        }
        .btn-outline-secondary {
            border-radius: var(--radius-lg);
            border-color: var(--color-border-strong);
            color: var(--color-text-secondary);
            min-width: 200px;
        }
        .btn-outline-secondary:hover {
            background: var(--color-bg-tertiary);
            border-color: var(--color-border-emphasis);
            color: var(--color-text-primary);
        }
        .btn-outline-secondary i {
            width: 18px;
            height: 18px;
        }
        .btn-primary i,
        .btn-outline-primary i {
            width: 18px;
            height: 18px;
        }

        /* Quick Tips */
        .quick-tips li::marker {
            color: var(--color-brand-primary);
        }
        .text-sm {
            font-size: var(--font-size-sm);
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set min datetime for preferred time
            const preferredInput = document.querySelector('input[name="PreferredTime"]');
            if (preferredInput) {
                const now = new Date();
                const isoString = now.toISOString().slice(0, 16);
                preferredInput.min = isoString;
            }

            // Form submission loading state
            const form = document.querySelector('.find-ride-form');
            const submitBtn = document.querySelector('.auth-submit');

            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    if (form.checkValidity()) {
                        submitBtn.disabled = true;
                        submitBtn.querySelector('.btn-text').classList.add('d-none');
                        submitBtn.querySelector('.btn-loader').classList.remove('d-none');
                    }
                });
            }

            // Initialize Lucide icons
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}