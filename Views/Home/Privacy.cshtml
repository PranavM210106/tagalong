@{
    ViewData["Title"] = "Privacy & Safety Policy";
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">Privacy & Safety</li>
            </ol>
        </nav>
        <header>
            <h1 id="page-title" class="display-5 fw-bold mb-1">Privacy & Safety Guidelines</h1>
            <p class="lead text-muted mb-0">How Tagalong protects your personal data, route GPS, and commuter security</p>
        </header>
    </div>
</section>

<section class="privacy-page py-4">
    <div class="container-fluid px-md-4 px-lg-5">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-xl-9">
                
                <!-- Trust Highlights Card -->
                <div class="card card-elevated p-4 p-md-5 mb-4" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-2xl);">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="p-3 rounded-circle" style="background: rgba(234, 179, 8, 0.12); color: var(--color-brand-primary);">
                            <i data-lucide="shield-check" style="width: 32px; height: 32px;"></i>
                        </div>
                        <div>
                            <h2 class="h4 fw-bold mb-1 text-white">Our Commuter Trust Commitment</h2>
                            <p class="text-muted mb-0">Built specifically for university campuses and city commuters in Rajkot, Gujarat.</p>
                        </div>
                    </div>

                    <div class="row g-4 mt-2">
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 h-100" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
                                <i data-lucide="map-pin" class="text-gold mb-2" style="width:22px;height:22px;"></i>
                                <h6 class="fw-bold text-white mb-1">Corridor Privacy</h6>
                                <p class="text-muted small mb-0">Precise house numbers are never broadcast publicly. Only general pickup stops and corridor lines are visible.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 h-100" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
                                <i data-lucide="phone-call" class="text-gold mb-2" style="width:22px;height:22px;"></i>
                                <h6 class="fw-bold text-white mb-1">Phone Protection</h6>
                                <p class="text-muted small mb-0">Phone numbers are revealed only after a booking is officially accepted by the driver for transit coordination.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 rounded-3 h-100" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);">
                                <i data-lucide="lock" class="text-gold mb-2" style="width:22px;height:22px;"></i>
                                <h6 class="fw-bold text-white mb-1">Zero Commercial Resale</h6>
                                <p class="text-muted small mb-0">Tagalong never sells commuter travel patterns or personal credentials to third-party ad networks.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Policy Sections -->
                <article class="card card-elevated p-4 p-md-5" style="background: var(--color-bg-card); border: 1px solid var(--color-border-default); border-radius: var(--radius-2xl);">
                    <div class="mb-5">
                        <h3 class="h5 fw-bold text-white mb-3">1. Information We Collect</h3>
                        <p class="text-muted leading-relaxed">
                            When registering for Tagalong, we collect your verified full name, academic or organizational email, contact phone number, and vehicle registration particulars (for drivers offering rides). GPS departure and destination points are collected solely to power our corridor matching algorithms.
                        </p>
                    </div>

                    <div class="mb-5">
                        <h3 class="h5 fw-bold text-white mb-3">2. In-App Messaging & Security</h3>
                        <p class="text-muted leading-relaxed">
                            Tagalong provides direct commute messaging between drivers and booked riders to coordinate pickup points. Chat histories are monitored strictly for community safety compliance, anti-harassment enforcement, and dispute resolution.
                        </p>
                    </div>

                    <div class="mb-5">
                        <h3 class="h5 fw-bold text-white mb-3">3. Two-Wheeler Safety Compliance (Helmet Mandate)</h3>
                        <p class="text-muted leading-relaxed">
                            In accordance with Gujarat Motor Vehicles Department regulations, all two-wheeler/bike-taxi carpools require both rider and pillion passenger to wear safety helmets throughout the trip. Drivers reserve the right to decline passengers refusing helmet compliance.
                        </p>
                    </div>

                    <div>
                        <h3 class="h5 fw-bold text-white mb-3">4. Support & Grievance Redressal</h3>
                        <p class="text-muted leading-relaxed mb-0">
                            Have concerns about an ongoing commute or an account safety matter? You can file a formal complaint via your <a asp-controller="Profile" asp-action="FileComplaint" class="text-gold text-decoration-none fw-semibold">Grievance Portal</a> or reach the campus fleet admin directly.
                        </p>
                    </div>
                </article>

            </div>
        </div>
    </div>
</section>
