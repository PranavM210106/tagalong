@model IEnumerable<Tagalong.Models.Entities.Ride>
@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section: Professional Mobility Experience (Uber & Rapido Grade) -->
<section class="hero-section" id="heroSection" aria-label="Hero Section">
    <!-- Full-bleed Commute Video Layer in Black Background -->
    <div class="hero-video-bg-container" aria-hidden="true">
        <video id="heroFullscreenVideo"
               class="hero-fullscreen-video"
               autoplay
               muted
               loop
               playsinline
               preload="auto"
               poster="~/images/hero/commute_poster.jpg"
               aria-label="App Commute Motion Video">
            <source src="~/videos/hero_commute_hd.mp4" type="video/mp4" />
            <source src="~/videos/car_commute_loop.mp4" type="video/mp4" />
        </video>
        <!-- Deep Cinematic Black Overlay & Subtle Grid -->
        <div class="hero-video-black-overlay"></div>
        <div class="hero-matrix-grid"></div>
    </div>

    <!-- Professional Hero Content Container -->
    <div class="container hero-content-container position-relative" style="z-index: 5;">
        <div class="row align-items-center justify-content-between g-5">
            
            <!-- Left Column: Compelling Narrative, Value Proposition & Dual Actions -->
            <div class="col-12 col-lg-7 hero-copy-col">
                <div class="hero-chip-pill mb-3 d-inline-flex align-items-center gap-2">
                    <span class="chip-glow-dot"></span>
                    <span class="chip-text">SMART CARPOOLING & DAILY COMMUTE</span>
                </div>

                <h1 class="hero-main-title text-white mb-3">
                    Share Rides.<br />
                    <span class="gradient-text-gold">Save Fuel.</span> Travel Smarter.
                </h1>

                <p class="hero-subtitle text-muted mb-4">
                    India's next-gen ride-sharing community. Split petrol costs in Rupees (₹), reduce traffic congestion, and travel with 100% verified commuters heading your exact way.
                </p>

                <!-- Dual Quick Action Buttons -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-4 hero-action-buttons">
                    <a asp-controller="Rides" asp-action="Find" class="btn btn-hero-primary d-inline-flex align-items-center gap-2">
                        <i data-lucide="search" class="hero-btn-icon" aria-hidden="true"></i>
                        <span>Find a Ride</span>
                    </a>
                    <a asp-controller="Rides" asp-action="Offer" class="btn btn-hero-ghost d-inline-flex align-items-center gap-2">
                        <i data-lucide="car" class="hero-btn-icon" aria-hidden="true"></i>
                        <span>Offer a Ride</span>
                    </a>
                </div>

                <!-- Verified Trust Proof Points -->
                <div class="hero-trust-row d-flex flex-wrap align-items-center gap-4 text-muted small">
                    <div class="trust-item d-flex align-items-center gap-2">
                        <i data-lucide="shield-check" class="text-warning" style="width:18px;height:18px;"></i>
                        <span>100% Verified Community</span>
                    </div>
                    <div class="trust-item d-flex align-items-center gap-2">
                        <i data-lucide="star" class="text-warning" style="width:18px;height:18px;"></i>
                        <span>4.9 / 5 Rating</span>
                    </div>
                    <div class="trust-item d-flex align-items-center gap-2">
                        <i data-lucide="indian-rupee" class="text-warning" style="width:18px;height:18px;"></i>
                        <span>Transparent ₹ Pricing</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive Quick Route Search Console (Uber/Rapido Style) -->
            <div class="col-12 col-lg-5 hero-widget-col">
                <div class="hero-console-card">
                    <div class="console-card-header d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom border-white-10">
                        <div class="d-flex align-items-center gap-2">
                            <i data-lucide="compass" class="text-warning" style="width:20px;height:20px;"></i>
                            <h3 class="h6 mb-0 fw-bold text-white">Find Your Commute</h3>
                        </div>
                        <span class="badge-live-route small">
                            <span class="live-dot"></span>
                            Live Routes
                        </span>
                    </div>

                    <form asp-controller="Rides" asp-action="Find" method="get" class="hero-search-form">
                        <div class="form-group mb-3">
                            <label class="console-label" for="heroPickup">Pickup Location</label>
                            <div class="console-input-wrap">
                                <i data-lucide="circle-dot" class="console-icon text-success"></i>
                                <input type="text" id="heroPickup" name="pickup" class="form-control console-input" placeholder="Enter pickup address or landmark" autocomplete="off" />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="console-label" for="heroDestination">Drop-off Destination</label>
                            <div class="console-input-wrap">
                                <i data-lucide="map-pin" class="console-icon text-warning"></i>
                                <input type="text" id="heroDestination" name="destination" class="form-control console-input" placeholder="Enter destination or college gate" autocomplete="off" />
                            </div>
                        </div>

                        <!-- Popular Hotspot Chips -->
                        <div class="mb-4">
                            <span class="console-sublabel">Popular Rajkot Stops:</span>
                            <div class="d-flex flex-wrap gap-1 mt-1 hero-chips">
                                <button type="button" class="btn-console-chip" onclick="document.getElementById('heroPickup').value='Marwadi University';">📍 Marwadi Univ</button>
                                <button type="button" class="btn-console-chip" onclick="document.getElementById('heroDestination').value='Madhapar Chowk';">📍 Madhapar</button>
                                <button type="button" class="btn-console-chip" onclick="document.getElementById('heroDestination').value='Rajkot Junction';">🚆 Junction</button>
                                <button type="button" class="btn-console-chip" onclick="document.getElementById('heroDestination').value='Crystal Mall';">🛍️ Crystal Mall</button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-console-submit w-100 d-flex align-items-center justify-content-center gap-2">
                            <i data-lucide="search" style="width:18px;height:18px;"></i>
                            <span>Search Matching Rides</span>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Centered Bottom Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
        <a href="#features-section" class="scroll-link" aria-label="Scroll to features">
            <i data-lucide="chevron-down" class="scroll-icon"></i>
        </a>
    </div>
</section>

<!-- Features Section -->
<section class="features-section" id="features-section" aria-labelledby="features-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <header class="text-center mb-5">
            <h2 id="features-title" class="display-5 fw-bold mb-3 text-white">Why Choose Tagalong?</h2>
            <p class="lead text-muted">Built for modern commuters who value convenience, safety, and transparent Rupee pricing.</p>
        </header>
        <div class="row g-4">
            <div class="col-12 col-md-4">
                <article class="feature-card h-100">
                    <div class="feature-icon">
                        <i data-lucide="map-pin" aria-hidden="true"></i>
                    </div>
                    <h3 class="feature-title">Smart GPS Matching</h3>
                    <p class="feature-description">Haversine and Google Maps intelligence instantly connects riders and drivers sharing identical commute corridors in Rajkot and beyond.</p>
                </article>
            </div>
            <div class="col-12 col-md-4">
                <article class="feature-card h-100">
                    <div class="feature-icon">
                        <i data-lucide="shield-check" aria-hidden="true"></i>
                    </div>
                    <h3 class="feature-title">100% Verified Community</h3>
                    <p class="feature-description">Every driver profile, car registration, and student/work ID is verified with authentic passenger reviews and star ratings.</p>
                </article>
            </div>
            <div class="col-12 col-md-4">
                <article class="feature-card h-100">
                    <div class="feature-icon">
                        <i data-lucide="indian-rupee" aria-hidden="true"></i>
                    </div>
                    <h3 class="feature-title">Affordable Rupee Pricing</h3>
                    <p class="feature-description">No surge pricing or hidden commissions. Set or pay transparent per-seat fares in Indian Rupees (₹) with dynamic earnings estimates.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<!-- Live Rides Section -->
<section class="rides-section" aria-labelledby="rides-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <header class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
            <div>
                <h2 id="rides-title" class="display-5 fw-bold mb-1 text-white">Rides Near You</h2>
                <p class="text-muted mb-0">Active carpooling routes departing soon</p>
            </div>
            <a asp-controller="Rides" asp-action="Find" class="btn btn-outline-primary">
                <i data-lucide="grid" class="me-2" aria-hidden="true"></i>
                View All Rides
            </a>
        </header>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4" role="list">
                @foreach (var ride in Model.Take(6))
                {
                    <div class="col-12 col-md-6 col-lg-4" role="listitem">
                        <article class="ride-card h-100">
                            <div class="ride-card-header">
                                <div class="route-badge">
                                    <i data-lucide="navigation" class="me-1" aria-hidden="true"></i>
                                    <span>@ride.StartLocation → @ride.EndLocation</span>
                                </div>
                                <time class="departure-time" datetime="@ride.DepartureTime.ToString("yyyy-MM-ddTHH:mm")">
                                    <i data-lucide="clock" class="me-1" aria-hidden="true"></i>
                                    @ride.DepartureTime.ToString("MMM dd, yyyy hh:mm tt")
                                </time>
                            </div>
                            <div class="ride-card-body">
                                <div class="ride-meta">
                                    <div class="meta-item">
                                        <i data-lucide="users" class="meta-icon" aria-hidden="true"></i>
                                        <span><strong>@ride.SeatsAvailable</strong> seats available</span>
                                    </div>
                                    <div class="meta-item">
                                        <span class="meta-icon text-gold fw-bold">₹</span>
                                        <span class="text-gold fw-bold fs-6">₹@ride.PricePerSeat <small class="text-muted fw-normal">/ seat</small></span>
                                    </div>
                                    <div class="meta-item">
                                        <i data-lucide="truck" class="meta-icon" aria-hidden="true"></i>
                                        <span>@(ride.Vehicle != null ? $"{ride.Vehicle.Model} ({ride.Vehicle.VehicleType})" : "Standard Vehicle")</span>
                                    </div>
                                </div>
                                <div class="driver-info d-flex align-items-center gap-3">
                                    <div class="driver-avatar">
                                        @if (!string.IsNullOrEmpty(ride.Driver?.ProfilePicture))
                                        {
                                            <img src="@ride.Driver.ProfilePicture" alt="@(ride.Driver?.FullName ?? "Driver")" class="rounded-circle" />
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center">
                                                <i data-lucide="user" class="avatar-icon" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <div class="driver-name fw-medium text-white">@(ride.Driver?.FullName ?? "Driver")</div>
                                        <div class="driver-rating d-flex align-items-center gap-1 text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i data-lucide="star" class="@(i <= (int)Math.Round(ride.Driver?.AverageRating ?? 0) ? "fill" : "")" aria-hidden="true"></i>
                                            }
                                            <span class="text-muted">@(ride.Driver?.AverageRating?.ToString("0.0") ?? "New")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="ride-card-footer">
                                @if (ride.SeatsAvailable > 0)
                                {
                                    <button type="button" class="btn btn-primary w-100 py-3 fw-bold btn-book-trigger"
                                            data-ride-id="@ride.RideId"
                                            data-route="@ride.StartLocation → @ride.EndLocation"
                                            data-driver="@(ride.Driver?.FullName ?? "Driver")"
                                            data-price="@ride.PricePerSeat"
                                            data-seats="@ride.SeatsAvailable"
                                            data-time="@ride.DepartureTime.ToString("MMM dd, hh:mm tt")"
                                            data-vehicle="@(ride.Vehicle != null ? $"{ride.Vehicle.Model} ({ride.Vehicle.RegistrationNumber})" : "Standard Commute")">
                                        <i data-lucide="user-plus" class="me-2" aria-hidden="true"></i>
                                        Request to Join
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-danger w-100 py-3 fw-medium fs-6">Full</span>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state text-center py-5" role="status">
                <div class="empty-icon mb-4">
                    <i data-lucide="car" class="mx-auto" style="width: 80px; height: 80px;" aria-hidden="true"></i>
                </div>
                <h3 class="h4 fw-bold mb-2 text-white">No active rides right now</h3>
                <p class="text-muted mb-4">Be the first to offer a ride and help commuters on your route.</p>
                <a asp-controller="Rides" asp-action="Offer" class="btn btn-primary px-4 py-2">
                    <i data-lucide="plus" class="me-2" aria-hidden="true"></i>
                    Offer a Ride
                </a>
            </div>
        }
    </div>
</section>


<!-- Booking Confirmation Modal (Uber & Rapido Grade) -->
<div class="modal fade" id="bookingConfirmModal" tabindex="-1" aria-labelledby="bookingConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #11131a; border: 1px solid rgba(255,255,255,0.12); border-radius: 20px;">
            <div class="modal-header border-bottom border-white-10 p-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold">₹ COMMUTE SHARE</span>
                    <h5 class="modal-title text-white fw-bold mb-0" id="bookingConfirmTitle">Confirm Your Ride</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Rides" asp-action="RequestToJoin" method="post" id="modalBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rideId" id="modalRideId" />
                <div class="modal-body p-4">
                    <!-- Route -->
                    <div class="p-3 rounded-3 mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);">
                        <div class="text-xs text-muted text-uppercase fw-semibold mb-1">Route Corridor</div>
                        <div class="text-white fw-bold fs-6" id="modalRoute">—</div>
                        <div class="text-muted small mt-1" id="modalTime">—</div>
                    </div>

                    <!-- Driver & Vehicle -->
                    <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                        <div>
                            <div class="text-xs text-muted text-uppercase fw-semibold">Driver</div>
                            <div class="text-white fw-medium" id="modalDriver">—</div>
                        </div>
                        <div class="text-end">
                            <div class="text-xs text-muted text-uppercase fw-semibold">Vehicle</div>
                            <div class="text-white small" id="modalVehicle">—</div>
                        </div>
                    </div>

                    <!-- Seats Selector -->
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: rgba(234, 179, 8, 0.08); border: 1px solid rgba(234, 179, 8, 0.25);">
                        <div>
                            <div class="fw-bold text-white">Seats to Reserve</div>
                            <div class="text-muted small"><span id="modalMaxSeats">0</span> seats available</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-warning" id="btnMinusSeat" style="width:32px;height:32px;border-radius:50%;">-</button>
                            <input type="number" name="seatsBooked" id="modalSeatsCount" value="1" min="1" max="4" readonly style="width:40px; text-align:center; background:transparent; border:none; color:#fff; font-weight:bold; font-size:1.1rem;" />
                            <button type="button" class="btn btn-sm btn-outline-warning" id="btnPlusSeat" style="width:32px;height:32px;border-radius:50%;">+</button>
                        </div>
                    </div>

                    <!-- Price Calculation -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white-10">
                        <span class="text-muted">Total Fare in ₹:</span>
                        <div class="text-gold fw-bold fs-4" id="modalTotalFare">₹0</div>
                    </div>
                </div>
                <div class="modal-footer border-top border-white-10 p-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        Confirm & Request Ride
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Hero Section: Professional Mobility Experience (Uber & Rapido Grade) */
        .hero-section {
            position: relative;
            min-height: calc(100vh - 70px);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #040406;
            padding: 5rem 0 4rem;
        }
        .hero-video-bg-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        .hero-fullscreen-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.58;
            filter: brightness(0.85) contrast(1.15);
            transition: opacity 0.5s ease;
        }
        .hero-video-black-overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 70% 40%, rgba(4, 4, 6, 0.4) 0%, rgba(4, 4, 6, 0.75) 55%, rgba(4, 4, 6, 0.94) 100%),
                        linear-gradient(180deg, rgba(4, 4, 6, 0.75) 0%, rgba(4, 4, 6, 0.5) 40%, rgba(4, 4, 6, 0.96) 100%);
            pointer-events: none;
            z-index: 2;
        }
        .hero-matrix-grid {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(234, 179, 8, 0.1) 1px, transparent 1px);
            background-size: 32px 32px;
            opacity: 0.35;
            pointer-events: none;
            z-index: 3;
        }

        /* Hero Typography & Narrative */
        .hero-content-container {
            z-index: 5;
            width: 100%;
        }
        .hero-chip-pill {
            background: rgba(234, 179, 8, 0.1);
            border: 1px solid rgba(234, 179, 8, 0.3);
            border-radius: 9999px;
            padding: 4px 14px 4px 10px;
        }
        .chip-glow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 8px #22c55e;
            display: inline-block;
        }
        .chip-text {
            color: #facc15;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
        }
        .hero-main-title {
            font-size: clamp(2.4rem, 4.5vw, 3.8rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.03em;
        }
        .gradient-text-gold {
            background: linear-gradient(135deg, #facc15 0%, #eab308 50%, #fef08a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-subtitle {
            font-size: 1.1rem;
            line-height: 1.6;
            max-width: 580px;
            color: rgba(255, 255, 255, 0.72) !important;
        }

        /* Hero Action Buttons */
        .btn-hero-primary {
            background: linear-gradient(135deg, #facc15 0%, #eab308 100%);
            color: #09090b !important;
            font-weight: 700;
            font-size: 1.05rem;
            padding: 14px 34px;
            border-radius: 9999px;
            border: none;
            box-shadow: 0 4px 22px rgba(234, 179, 8, 0.42);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
        }
        .btn-hero-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(234, 179, 8, 0.6);
            color: #000000 !important;
        }
        .btn-hero-ghost {
            background: rgba(255, 255, 255, 0.05);
            color: #ffffff !important;
            font-weight: 600;
            font-size: 1.05rem;
            padding: 14px 34px;
            border-radius: 9999px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: all 0.25s ease;
            text-decoration: none;
        }
        .btn-hero-ghost:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.4);
            color: #ffffff !important;
            transform: translateY(-2px);
        }
        .hero-btn-icon {
            width: 19px;
            height: 19px;
        }
        .hero-trust-row {
            padding-top: 0.5rem;
        }
        .trust-item {
            font-weight: 500;
            color: rgba(255, 255, 255, 0.65);
        }

        /* Right Column Search Console (Uber & Rapido Grade) */
        .hero-console-card {
            background: rgba(13, 13, 18, 0.88);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 26px;
            box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 1px 1px rgba(234, 179, 8, 0.25);
            transition: border-color 0.3s ease;
        }
        .hero-console-card:hover {
            border-color: rgba(234, 179, 8, 0.35);
        }
        .border-white-10 {
            border-color: rgba(255, 255, 255, 0.08) !important;
        }
        .badge-live-route {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.3);
            border-radius: 9999px;
            padding: 3px 10px;
            font-size: 0.72rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .live-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 6px #22c55e;
            display: inline-block;
        }
        .console-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: rgba(255, 255, 255, 0.65);
            margin-bottom: 6px;
        }
        .console-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }
        .console-icon {
            position: absolute;
            left: 14px;
            width: 17px;
            height: 17px;
            pointer-events: none;
            z-index: 2;
        }
        .console-input {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border-radius: 12px;
            padding: 12px 14px 12px 42px;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }
        .console-input:focus {
            background: rgba(255, 255, 255, 0.07);
            border-color: #facc15;
            color: #ffffff;
            box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.18);
        }
        .console-input::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }
        .console-sublabel {
            font-size: 0.7rem;
