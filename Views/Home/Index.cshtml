@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Autoplay and keep background video looping smoothly
            const heroVideo = document.getElementById('heroFullscreenVideo');
            if (heroVideo) {
                heroVideo.muted = true;
                const playPromise = heroVideo.play();
                if (playPromise !== undefined) {
                    playPromise.catch(function() {
                        // User agent or low battery prevented autoplay; fallback poster remains active
                        heroVideo.controls = false;
                    });
                }
            }

            
        // Booking Modal Interactivity
        let currentPricePerSeat = 0;
        let currentAvailableSeats = 1;

        function updateModalTotal() {
            const countInput = document.getElementById('modalSeatsCount');
            const totalEl = document.getElementById('modalTotalFare');
            const count = parseInt(countInput.value) || 1;
            totalEl.textContent = '₹' + (count * currentPricePerSeat);
        }

        document.querySelectorAll('.btn-book-trigger').forEach(btn => {
            btn.addEventListener('click', function() {
                const rideId = this.getAttribute('data-ride-id');
                const route = this.getAttribute('data-route');
                const driver = this.getAttribute('data-driver');
                const price = parseFloat(this.getAttribute('data-price')) || 0;
                const seats = parseInt(this.getAttribute('data-seats')) || 1;
                const time = this.getAttribute('data-time');
                const vehicle = this.getAttribute('data-vehicle');

                currentPricePerSeat = price;
                currentAvailableSeats = seats;

                document.getElementById('modalRideId').value = rideId;
                document.getElementById('modalRoute').textContent = route;
                document.getElementById('modalDriver').textContent = driver;
                document.getElementById('modalTime').textContent = time;
                document.getElementById('modalVehicle').textContent = vehicle;
                document.getElementById('modalMaxSeats').textContent = seats;
                document.getElementById('modalSeatsCount').value = 1;

                updateModalTotal();

                const modal = new bootstrap.Modal(document.getElementById('bookingConfirmModal'));
                modal.show();
            });
        });

        const btnMinus = document.getElementById('btnMinusSeat');
        const btnPlus = document.getElementById('btnPlusSeat');
        if (btnMinus) {
            btnMinus.addEventListener('click', function() {
                const countInput = document.getElementById('modalSeatsCount');
                let count = parseInt(countInput.value) || 1;
                if (count > 1) {
                    countInput.value = count - 1;
                    updateModalTotal();
                }
            });
        }
        if (btnPlus) {
            btnPlus.addEventListener('click', function() {
                const countInput = document.getElementById('modalSeatsCount');
                let count = parseInt(countInput.value) || 1;
                if (count < currentAvailableSeats) {
                    countInput.value = count + 1;
                    updateModalTotal();
                }
            });
        }

            // Initialize Place Autocomplete on Hero Search Inputs
            if (window.TagalongPlaceAutocomplete) {
                TagalongPlaceAutocomplete.attach('#heroPickup', {
                    placeholderIcon: 'pickup'
                });
                TagalongPlaceAutocomplete.attach('#heroDestination', {
                    placeholderIcon: 'destination'
                });
            }

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}
