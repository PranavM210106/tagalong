@model Tagalong.Models.ViewModels.MyRidesViewModel
@{
    ViewData["Title"] = "My Rides & Bookings";
    var queryTab = Context.Request.Query["tab"].ToString();
    var viewDataTab = ViewData["ActiveTab"] as string;
    string targetTab = !string.IsNullOrEmpty(queryTab) ? queryTab : (!string.IsNullOrEmpty(viewDataTab) ? viewDataTab : "");
    
    bool isDriverRole = User.IsInRole("Driver");
    int driverRidesCount = Model.AsDriver?.Count() ?? 0;
    int riderBookingsCount = Model.AsRider?.Count() ?? 0;

    bool showDriverTabFirst = targetTab == "driver" || (targetTab != "rider" && isDriverRole && driverRidesCount > 0 && riderBookingsCount == 0);
}

<section class="page-header" aria-labelledby="page-title">
    <div class="container-fluid px-md-4 px-lg-5">
        <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted">Home</a></li>
                <li class="breadcrumb-item text-gold fw-medium" aria-current="page">My Rides</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h1 id="page-title" class="display-5 fw-bold mb-1">My Rides & Bookings</h1>
                <p class="lead text-muted mb-0">Manage your offered rides and booked journeys</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Rides" asp-action="Offer" class="btn btn-primary">
                    <i data-lucide="plus" class="me-1" aria-hidden="true"></i> Offer a Ride
                </a>
                <a asp-controller="Rides" asp-action="Find" class="btn btn-outline-light">
                    <i data-lucide="search" class="me-1" aria-hidden="true"></i> Find a Ride
                </a>
            </div>
        </div>
    </div>
</section>

<section class="my-rides-page py-4">
    <div class="container-fluid px-md-4 px-lg-5">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #6ee7b7; border-radius: 12px;">
                <i data-lucide="check-circle" style="width:20px;height:20px;flex-shrink:0;"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5; border-radius: 12px;">
                <i data-lucide="alert-circle" style="width:20px;height:20px;flex-shrink:0;"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs nav-fill mb-4" id="ridesTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(showDriverTabFirst ? "" : "active") d-flex align-items-center justify-content-center gap-2 py-3" id="rider-tab" data-bs-toggle="tab" data-bs-target="#rider-pane" type="button" role="tab" aria-controls="rider-pane" aria-selected="@(showDriverTabFirst ? "false" : "true")">
                    <i data-lucide="user-check" style="width: 18px; height: 18px;"></i>
                    <span>As Rider (@riderBookingsCount)</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(showDriverTabFirst ? "active" : "") d-flex align-items-center justify-content-center gap-2 py-3" id="driver-tab" data-bs-toggle="tab" data-bs-target="#driver-pane" type="button" role="tab" aria-controls="driver-pane" aria-selected="@(showDriverTabFirst ? "true" : "false")">
                    <i data-lucide="car" style="width: 18px; height: 18px;"></i>
                    <span>As Driver (@driverRidesCount)</span>
                </button>
            </li>
        </ul>

        <div class="tab-content" id="ridesTabContent">
            <!-- Rider Pane -->
            <div class="tab-pane fade @(showDriverTabFirst ? "" : "show active")" id="rider-pane" role="tabpanel" aria-labelledby="rider-tab">
                @if (Model.AsRider != null && Model.AsRider.Any())
                {
                    <div class="row g-4">
                        @foreach (var booking in Model.AsRider)
                        {
                            var totalCost = booking.Ride != null ? (booking.SeatsBooked * booking.Ride.PricePerSeat) : 0m;
                            <div class="col-12 col-lg-6">
                                <article class="card card-elevated h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(booking.BookingStatus == "Confirmed" ? "badge-success" : booking.BookingStatus == "Pending" ? "badge-warning" : booking.BookingStatus == "Completed" ? "badge-info" : "badge-secondary")">
                                                @booking.BookingStatus
                                            </span>
                                            <span class="text-xs text-muted">ID: #@booking.BookingId (@booking.SeatsBooked @(booking.SeatsBooked == 1 ? "seat" : "seats"))</span>
                                        </div>
                                        <div class="text-gold fw-bold fs-5">
                                            ₹@totalCost
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- Commute Progress Stepper -->
                                        <div class="commute-stepper d-flex align-items-center justify-content-between mb-4 px-1">
                                            <div class="stepper-item completed">
                                                <div class="stepper-bubble"><i data-lucide="check" style="width:12px;height:12px;"></i></div>
                                                <span class="stepper-text">Requested</span>
                                            </div>
                                            <div class="stepper-bar @(booking.BookingStatus == "Confirmed" || booking.BookingStatus == "Completed" ? "active" : "")"></div>
                                            <div class="stepper-item @(booking.BookingStatus == "Confirmed" || booking.BookingStatus == "Completed" ? "completed" : booking.BookingStatus == "Pending" ? "active" : "")">
                                                <div class="stepper-bubble">@(booking.BookingStatus == "Confirmed" || booking.BookingStatus == "Completed" ? "✓" : "2")</div>
                                                <span class="stepper-text">Confirmed</span>
                                            </div>
                                            <div class="stepper-bar @(booking.BookingStatus == "Completed" ? "active" : "")"></div>
                                            <div class="stepper-item @(booking.BookingStatus == "Completed" ? "completed" : "")">
                                                <div class="stepper-bubble">@(booking.BookingStatus == "Completed" ? "✓" : "3")</div>
                                                <span class="stepper-text">Completed</span>
                                            </div>
                                        </div>

                                        <!-- Route timeline -->
                                        <div class="route-timeline mb-4">
                                            <div class="route-stop d-flex align-items-start gap-3 mb-2">
                                                <div class="route-dot bg-success mt-1"></div>
                                                <div>
                                                    <div class="text-xs text-muted text-uppercase fw-semibold">Pickup</div>
                                                    <div class="fw-medium text-white">@booking.Ride?.StartLocation</div>
                                                </div>
                                            </div>
                                            <div class="route-connector ms-2"></div>
                                            <div class="route-stop d-flex align-items-start gap-3">
                                                <div class="route-dot bg-danger mt-1"></div>
                                                <div>
                                                    <div class="text-xs text-muted text-uppercase fw-semibold">Drop-off</div>
                                                    <div class="fw-medium text-white">@booking.Ride?.EndLocation</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Ride Specs -->
                                        <div class="row g-2 pt-3 border-top border-secondary text-sm">
                                            <div class="col-6 col-sm-4">
                                                <div class="text-muted text-xs">Departure</div>
                                                <div class="fw-medium">@booking.Ride?.DepartureTime.ToString("MMM dd, h:mm tt")</div>
                                            </div>
                                            <div class="col-6 col-sm-4">
                                                <div class="text-muted text-xs">Driver</div>
                                                <div class="fw-medium">@(booking.Ride?.Driver?.FullName ?? "Assigned Driver")</div>
                                            </div>
                                            <div class="col-12 col-sm-4">
                                                <div class="text-muted text-xs">Vehicle</div>
                                                <div class="fw-medium">@(booking.Ride?.Vehicle != null ? $"{booking.Ride.Vehicle.Model} ({booking.Ride.Vehicle.RegistrationNumber})" : "Confirmed Vehicle")</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer d-flex flex-wrap gap-2 justify-content-between align-items-center">
                                        <a asp-controller="Chat" asp-action="Thread" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-primary">
                                            <i data-lucide="message-square" style="width: 15px; height: 15px;"></i> Chat Driver
                                        </a>
                                        <div class="d-flex gap-2">
                                            @if (booking.BookingStatus != "Cancelled" && booking.BookingStatus != "Completed")
                                            {
                                                <form asp-controller="Bookings" asp-action="CancelBooking" method="post" onsubmit="return confirm('Cancel this ride booking?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Booking</button>
                                                </form>
                                            }
                                            <a asp-controller="Profile" asp-action="FileComplaint" asp-route-bookingId="@booking.BookingId" class="btn btn-sm btn-ghost text-muted">
                                                Report Issue
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card card-elevated text-center py-5">
                        <div class="avatar avatar-xl mx-auto mb-3 bg-secondary">
                            <i data-lucide="compass" style="width: 32px; height: 32px; color: var(--color-brand-primary);"></i>
                        </div>
                        <h3 class="h4 fw-bold">No Booked Rides Yet</h3>
                        <p class="text-muted small mb-4">Find a ride heading in your direction and travel affordably.</p>
                        <div>
                            <a asp-controller="Rides" asp-action="Find" class="btn btn-primary">
                                <i data-lucide="search" class="me-1"></i> Find Rides Now
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Driver Pane -->
            <div class="tab-pane fade @(showDriverTabFirst ? "show active" : "")" id="driver-pane" role="tabpanel" aria-labelledby="driver-tab">
                @if (Model.AsDriver != null && Model.AsDriver.Any())
                {
                    <div class="row g-4">
                        @foreach (var ride in Model.AsDriver)
                        {
                            var activeBookings = ride.Bookings?.Where(b => b.BookingStatus != "Cancelled").ToList() ?? new List<Tagalong.Models.Entities.Booking>();
                            var pendingCount = ride.Bookings?.Count(b => b.BookingStatus == "Pending") ?? 0;
                            var totalEarned = activeBookings.Sum(b => b.SeatsBooked * ride.PricePerSeat);

                            <div class="col-12 col-lg-6">
                                <article class="card card-elevated h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge @(ride.Status == "Active" ? "badge-success" : ride.Status == "Completed" ? "badge-info" : "badge-secondary")">
                                                @ride.Status
                                            </span>
                                            <span class="text-xs text-muted">Seats: @ride.SeatsAvailable Available</span>
                                            @if (pendingCount > 0)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold animate-pulse">
                                                    @pendingCount Request@(pendingCount > 1 ? "s" : "") Pending
                                                </span>
                                            }
                                        </div>
                                        <div class="text-gold fw-bold fs-5">
                                            ₹@ride.PricePerSeat <span class="text-xs text-muted">/seat</span>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- Driver Operational Stepper -->
                                        <div class="commute-stepper d-flex align-items-center justify-content-between mb-4 px-1">
                                            <div class="stepper-item completed">
                                                <div class="stepper-bubble"><i data-lucide="check" style="width:12px;height:12px;"></i></div>
                                                <span class="stepper-text">Offered</span>
                                            </div>
                                            <div class="stepper-bar @(ride.Status == "Active" || ride.Status == "Completed" ? "active" : "")"></div>
                                            <div class="stepper-item @(ride.Status == "Active" || ride.Status == "Completed" ? "completed" : "")">
                                                <div class="stepper-bubble">✓</div>
                                                <span class="stepper-text">@(ride.Status == "Active" ? "Booking Open" : "Active")</span>
                                            </div>
                                            <div class="stepper-bar @(ride.Status == "Completed" ? "active" : "")"></div>
                                            <div class="stepper-item @(ride.Status == "Completed" ? "completed" : "")">
                                                <div class="stepper-bubble">@(ride.Status == "Completed" ? "✓" : "3")</div>
                                                <span class="stepper-text">Completed</span>
                                            </div>
                                        </div>

                                        <!-- Route -->
                                        <div class="route-timeline mb-4">
                                            <div class="route-stop d-flex align-items-start gap-3 mb-2">
                                                <div class="route-dot bg-success mt-1"></div>
                                                <div>
                                                    <div class="text-xs text-muted text-uppercase fw-semibold">From</div>
                                                    <div class="fw-medium text-white">@ride.StartLocation</div>
                                                </div>
                                            </div>
                                            <div class="route-connector ms-2"></div>
                                            <div class="route-stop d-flex align-items-start gap-3">
                                                <div class="route-dot bg-danger mt-1"></div>
                                                <div>
                                                    <div class="text-xs text-muted text-uppercase fw-semibold">To</div>
                                                    <div class="fw-medium text-white">@ride.EndLocation</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row g-2 pt-3 border-top border-secondary text-sm">
                                            <div class="col-6">
                                                <div class="text-muted text-xs">Departure Time</div>
                                                <div class="fw-medium">@ride.DepartureTime.ToString("MMM dd, yyyy h:mm tt")</div>
                                            </div>
                                            <div class="col-6">
                                                <div class="text-muted text-xs">Vehicle Assigned</div>
                                                <div class="fw-medium">@(ride.Vehicle != null ? $"{ride.Vehicle.Model} ({ride.Vehicle.RegistrationNumber})" : "Registered Vehicle")</div>
                                            </div>
                                        </div>

                                        <!-- Passengers & Booking Requests Section -->
                                        <div class="passengers-section mt-4 pt-3 border-top border-secondary">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i data-lucide="users" class="text-gold" style="width: 18px; height: 18px;"></i>
                                                    <h6 class="text-white fw-bold mb-0">Passengers & Booking Requests</h6>
                                                </div>
                                                <span class="badge @(activeBookings.Any() ? "badge-primary" : "badge-secondary")">
                                                    @activeBookings.Count Joined • ₹@totalEarned Total
                                                </span>
                                            </div>

                                            @if (ride.Bookings != null && ride.Bookings.Any())
                                            {
                                                <div class="passenger-list d-flex flex-column gap-3">
                                                    @foreach (var booking in ride.Bookings.OrderByDescending(b => b.BookingId))
                                                    {
                                                        <div class="passenger-item p-3 rounded" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                                                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-2">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <div class="avatar avatar-sm rounded-circle d-flex align-items-center justify-content-center bg-secondary text-white fw-bold" style="width:36px;height:36px;font-size:14px;">
                                                                        @(booking.Rider?.FullName?.Substring(0, 1).ToUpper() ?? "R")
                                                                    </div>
                                                                    <div>
                                                                        <div class="fw-semibold text-white">@(booking.Rider?.FullName ?? "Rider")</div>
                                                                        <div class="text-xs text-muted">
                                                                            <i data-lucide="phone" class="me-1" style="width:12px;height:12px;"></i>
                                                                            @(booking.Rider?.PhoneNumber ?? booking.Rider?.Email ?? "No contact details")
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="d-flex align-items-center gap-2">
                                                                    <span class="badge @(booking.BookingStatus == "Confirmed" ? "badge-success" : booking.BookingStatus == "Pending" ? "badge-warning" : booking.BookingStatus == "Completed" ? "badge-info" : "badge-secondary")">
                                                                        @booking.BookingStatus
                                                                    </span>
                                                                    <span class="badge bg-dark border border-secondary text-gold">
                                                                        @booking.SeatsBooked @(booking.SeatsBooked == 1 ? "seat" : "seats") • ₹@(booking.SeatsBooked * ride.PricePerSeat)
                                                                    </span>
                                                                </div>
                                                            </div>

                                                            <!-- Actions for this passenger -->
                                                            <div class="d-flex flex-wrap gap-2 justify-content-end align-items-center pt-2 border-top border-white-10">
                                                                <a asp-controller="Chat" asp-action="Thread" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 py-1 px-2" style="font-size: 12px;">
                                                                    <i data-lucide="message-square" style="width:13px;height:13px;"></i> Chat
                                                                </a>

                                                                @if (booking.BookingStatus == "Pending")
                                                                {
                                                                    <form asp-controller="Bookings" asp-action="ConfirmRider" method="post" class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                                        <button type="submit" class="btn btn-sm btn-success d-flex align-items-center gap-1 py-1 px-2" style="font-size: 12px;">
                                                                            <i data-lucide="check" style="width:13px;height:13px;"></i> Accept
                                                                        </button>
                                                                    </form>
                                                                    <form asp-controller="Bookings" asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('Decline this passenger request?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 py-1 px-2" style="font-size: 12px;">
                                                                            <i data-lucide="x" style="width:13px;height:13px;"></i> Decline
                                                                        </button>
                                                                    </form>
                                                                }
                                                                else if (booking.BookingStatus == "Confirmed" && ride.Status == "Active")
                                                                {
                                                                    <form asp-controller="Bookings" asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('Remove this passenger and restore seat availability?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 py-1 px-2" style="font-size: 12px;">
                                                                            <i data-lucide="user-minus" style="width:13px;height:13px;"></i> Remove
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-3 text-center rounded" style="background: rgba(255, 255, 255, 0.02); border: 1px dashed rgba(255, 255, 255, 0.1);">
                                                    <i data-lucide="users" class="text-muted mb-1" style="width: 20px; height: 20px;"></i>
                                                    <p class="text-muted text-xs mb-0">No passengers joined yet. Your ride is live and visible on the homepage & search!</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <span class="text-xs text-muted">
                                            <i data-lucide="clock" class="me-1" style="width:13px;height:13px;"></i>
                                            @(ride.DepartureTime > DateTime.Now ? $"Departs in {(int)(ride.DepartureTime - DateTime.Now).TotalHours}h {(int)(ride.DepartureTime - DateTime.Now).Minutes}m" : "Departure time reached")
                                        </span>
                                        <div class="d-flex gap-2">
                                            @if (ride.Status == "Active")
                                            {
                                                <form asp-controller="Bookings" asp-action="MarkCompleted" method="post" onsubmit="return confirm('Mark this ride as completed? All confirmed passengers will be marked completed.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="rideId" value="@ride.RideId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1">
                                                        <i data-lucide="check-circle" style="width:14px;height:14px;"></i> Complete Trip
                                                    </button>
                                                </form>
                                            }
                                            <a asp-controller="Rides" asp-action="Results" asp-route-pickup="@ride.StartLocation" asp-route-dropoff="@ride.EndLocation" class="btn btn-sm btn-outline-light">
                                                View Live
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card card-elevated text-center py-5">
                        <div class="avatar avatar-xl mx-auto mb-3 bg-secondary">
                            <i data-lucide="car" style="width: 32px; height: 32px; color: var(--color-brand-primary);"></i>
                        </div>
                        <h3 class="h4 fw-bold">You Haven't Offered Any Rides</h3>
                        <p class="text-muted small mb-4">Offset your fuel costs and meet co-travelers by offering spare seats.</p>
                        <div>
                            <a asp-controller="Rides" asp-action="Offer" class="btn btn-primary">
                                <i data-lucide="plus" class="me-1"></i> Offer a Ride
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .nav-tabs {
            border-bottom: 1px solid var(--color-border-default);
        }
        .nav-tabs .nav-link {
            color: var(--color-text-muted);
            border: none;
            border-bottom: 2px solid transparent;
            font-weight: var(--font-weight-medium);
            background: transparent;
            transition: all var(--transition-fast);
        }
        .nav-tabs .nav-link:hover {
            color: var(--color-text-primary);
            border-color: var(--color-border-strong);
        }
        .nav-tabs .nav-link.active {
            color: var(--color-brand-primary);
            border-bottom: 2px solid var(--color-brand-primary);
            background: rgba(234, 179, 8, 0.05);
        }
        .route-timeline {
            position: relative;
        }
        .route-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .route-connector {
            width: 2px;
            height: 18px;
            background: var(--color-border-strong);
            margin: -4px 0 -4px 4px;
        }
    
        /* Commute Progress Stepper (Rapido & Uber Style) */
        .commute-stepper {
            background: rgba(255, 255, 255, 0.03);
            border-radius: var(--radius-lg);
            padding: 10px 14px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        .stepper-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            position: relative;
            z-index: 2;
        }
        .stepper-bubble {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            color: var(--color-text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
        }
        .stepper-item.active .stepper-bubble {
            background: rgba(234, 179, 8, 0.2);
            color: var(--color-brand-primary);
            border: 1px solid var(--color-brand-primary);
        }
        .stepper-item.completed .stepper-bubble {
            background: var(--color-brand-primary);
            color: #000;
        }
        .stepper-text {
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--color-text-muted);
            letter-spacing: 0.04em;
        }
        .stepper-item.completed .stepper-text,
        .stepper-item.active .stepper-text {
            color: #fff;
        }
        .stepper-bar {
            flex: 1;
            height: 2px;
            background: rgba(255, 255, 255, 0.1);
            margin: -14px 8px 0;
            z-index: 1;
        }
        .stepper-bar.active {
            background: var(--color-brand-primary);
        }

        @@keyframes pulseSlow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        .animate-pulse {
            animation: pulseSlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Check hash in URL (e.g. #driver-pane)
            if (window.location.hash) {
                var triggerEl = document.querySelector('button[data-bs-target="' + window.location.hash + '"]');
                if (triggerEl) {
                    var tab = new bootstrap.Tab(triggerEl);
                    tab.show();
                }
            }
        });
    </script>
}
