@using Tagalong.Models.Entities
@model dynamic
@{
    ViewData["Title"] = "Chat";
    var booking = Model.Booking;
    var messages = Model.Messages;
    var userId = Context.User.Identity.Name; // This will be the email, but we need to get the actual user id
    // In a real app, we'd pass the current user id to the view or get it from User.Claims
}

<h2>Chat with Ride Partner</h2>

<div>
    <div class="mb-3">
        <strong>Ride:</strong> @booking.StartLocation → @booking.EndLocation
    </div>
    <div class="mb-3">
        <strong>Departure:</strong> @booking.DepartureTime.ToString("MMM dd, yyyy hh:mm tt")
    </div>
    <div class="mb-3">
        <strong>Your Role:</strong> @(User.IsInRole("Driver") ? "Driver" : "Rider")
    </div>
</div>

<div id="chat-container" style="border: 1px solid #ddd; height: 400px; overflow-y: auto; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
    @foreach (var message in messages)
    {
        var isCurrentUser = message.SenderId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        <div class="mb-2 p-2" style="background-color: @(isCurrentUser ? "#e3f2fd" : "#f5f5f5"); border-radius: 4px; max-width: 80%; margin-left: @(isCurrentUser ? "auto" : 0); margin-right: @(!isCurrentUser ? "auto" : 0); clear: both;">
            <div>
                <strong>@message.SenderName:</strong> @message.Content
            </div>
            <div class="text-muted small" style="text-align: @(isCurrentUser ? "right" : "left");">
                @message.Timestamp.ToString("hh:mm tt")
            </div>
        </div>
    }
</div>

<form id="chat-form">
    <div class="input-group">
        <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
        <button class="btn btn-primary" type="submit">Send</button>
    </div>
    <input type="hidden" id="bookingId" value="@booking.BookingId" />
</form>

<div class="mt-3">
    <a asp-controller="Bookings" asp-action="MyRides" class="btn btn-link">Back to My Rides</a>
</div>

@section Scripts {
    <script>
        document.getElementById('chat-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const messageInput = document.getElementById('messageInput');
            const bookingId = document.getElementById('bookingId').value;
            const messageText = messageInput.value.trim();
            
            if (messageText) {
                fetch('@Url.Action("SendMessage", "Chat")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new URLSearchParams({
                        'bookingId': bookingId,
                        'messageText': messageText
                    })
                })
                .then(response => response.ok ? response.text() : Promise.reject(response))
                .then(html => {
                    // Simple approach: reload the page to show new message
                    // In a real app, you'd use SignalR or AJAX to append the message
                    document.getElementById('chat-container').innerHTML += `
                        <div class="mb-2 p-2" style="background-color: #e3f2fd; border-radius: 4px; max-width: 80%; margin-left: auto;">
                            <div>
                                <strong>You:</strong> ${messageText}
                            </div>
                            <div class="text-muted small" style="text-align: right;">
                                ${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                            </div>
                        </div>
                    `;
                    messageInput.value = '';
                    // Scroll to bottom
                    const chatContainer = document.getElementById('chat-container');
                    chatContainer.scrollTop = chatContainer.scrollHeight;
                })
                .catch(err => {
                    console.error('Error sending message:', err);
                    alert('Failed to send message. Please try again.');
                });
            }
        });
    </script>
}
